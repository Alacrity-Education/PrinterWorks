                                      1 ; cap_code.s inner loop, verbatim instruction mix, reading a RAM address
                                      2 ; (0x0100) instead of PC_IDR; 640 iterations then halt.
                                      3     .module capsim
                                      4     .globl _capsim
                                      5     .area CODE
      000000                          6 _capsim:
      000000 90 AE 02 80      [ 2]    7     ldw     y, #640
      000004                          8 00012$:
      000004 49               [ 1]    9     rlc     a
      000005 72 06 01 00 01   [ 2]   10     btjt    0x0100, #3, 00001$
      00000A 9D               [ 1]   11     nop
      00000B 49               [ 1]   12 00001$: rlc     a
      00000C 72 06 01 00 01   [ 2]   13     btjt    0x0100, #3, 00002$
      000011 9D               [ 1]   14     nop
      000012 49               [ 1]   15 00002$: rlc     a
      000013 72 06 01 00 01   [ 2]   16     btjt    0x0100, #3, 00003$
      000018 9D               [ 1]   17     nop
      000019 49               [ 1]   18 00003$: rlc     a
      00001A 72 06 01 00 01   [ 2]   19     btjt    0x0100, #3, 00004$
      00001F 9D               [ 1]   20     nop
      000020 49               [ 1]   21 00004$: rlc     a
      000021 72 06 01 00 01   [ 2]   22     btjt    0x0100, #3, 00005$
      000026 9D               [ 1]   23     nop
      000027 49               [ 1]   24 00005$: rlc     a
      000028 72 06 01 00 01   [ 2]   25     btjt    0x0100, #3, 00006$
      00002D 9D               [ 1]   26     nop
      00002E 49               [ 1]   27 00006$: rlc     a
      00002F F7               [ 1]   28     ld      (x), a
      000030 5C               [ 1]   29     incw    x
      000031 72 06 01 00 01   [ 2]   30     btjt    0x0100, #3, 00007$
      000036 9D               [ 1]   31     nop
      000037 49               [ 1]   32 00007$: rlc     a
      000038 90 5A            [ 2]   33     decw    y
      00003A 72 06 01 00 01   [ 2]   34     btjt    0x0100, #3, 00008$
      00003F 9D               [ 1]   35     nop
      000040                         36 00008$:
      000040 26 C2            [ 1]   37     jrne    00012$
      000042 81               [ 4]   38     ret
