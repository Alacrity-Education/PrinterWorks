      0004F1 26 30            [ 1] 1051     jrne    00109$
      0004F3 BE 26            [ 2] 1052     ldw     x, *m_n+2
      0004F5 A3 9C 40         [ 2] 1053     cpw     x, #40000               ; RELAXATION A: v2.3 window
      0004F8 25 29            [ 1] 1054     jrc     00109$
      0004FA A3 FA 01         [ 2] 1055     cpw     x, #64001               ; (was 46000 .. 60000)
      0004FD 24 24            [ 1] 1056     jrnc    00109$
