      000804 A3 00 40         [ 2] 1617     cpw     x, #64                  ; DW_OFF_MAX
      000807 25 03            [ 1] 1618     jrc     00193$
      000809 A6 01            [ 1] 1619     ld      a, #1                   ; off >= 64: healthy (Z clear)
      00080B 81               [ 4] 1620     ret
      00080C                       1621 00193$:
      00080C B6 89            [ 1] 1622     ld      a, *m_off+1             ; off < 64, so hb = off << 9 is
      00080E 48               [ 1] 1623     sll     a                       ; hb_hi = off*2, hb_lo = 0
      00080F 95               [ 1] 1624     ld      xh, a
      000810 4F               [ 1] 1625     clr     a
      000811 97               [ 1] 1626     ld      xl, a                   ; X = hb
      000812 90 93            [ 1] 1627     ldw     y, x
      000814 72 BB 00 76      [ 2] 1628     addw    x, m_h0
      000818 4F               [ 1] 1629     clr     a                       ; BEFORE the compare: CLR touches N/Z,
                                   1630                                     ; which the SIGNED branch below reads
