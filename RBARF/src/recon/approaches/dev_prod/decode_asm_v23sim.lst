      0004CE A3 00 08         [ 2] 1036     cpw     x, #8
      0004D1 25 50            [ 1] 1037     jrc     00109$
      0004D3 BE 46            [ 2] 1038     ldw     x, *r_mehi              ; flm <= r0m -> fail
      0004D5 72 B0 00 48      [ 2] 1039     subw    x, r_de
      0004D9 25 48            [ 1] 1040     jrc     00109$
      0004DB 27 46            [ 1] 1041     jreq    00109$
