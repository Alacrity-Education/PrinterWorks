                                    678     .area CODE
                                    679 
                                    680 ; ---------------------------------------------------------------- refine
      00025B                        681 _refine:
      00025B AE 00 14         [ 2]  682     ldw     x, #20                  ; zero r_lo + r_hi (adjacent)
      00025E                        683 00060$:
      00025E 72 4F 00 2F      [ 1]  684     clr     (r_lo-1, x)
      000262 5A               [ 2]  685     decw    x
      000263 26 F9            [ 1]  686     jrne    00060$
      000265 CD 0F B4         [ 4]  687     call    _scan_init
      000268                        688 00061$:                         ; pulse loop
      000268 CD 0F D0         [ 4]  689     call    _scan_next
      00026B 4D               [ 1]  690     tnz     a
      00026C 27 6A            [ 1]  691     jreq    00070$
      00026E CE 00 AE         [ 2]  692     ldw     x, _scan_ra
      000271 72 BB 00 B0      [ 2]  693     addw    x, _scan_rb
      000275 54               [ 2]  694     srlw    x
      000276 CD 00 34         [ 4]  695     call    mr16
      000279 3D 09            [ 1]  696     tnz     *m_y
      00027B 2A 05            [ 1]  697     jrpl    00062$
      00027D 5F               [ 1]  698     clrw    x                   ; clamp y >= 0
      00027E BF 09            [ 2]  699     ldw     *m_y, x
      000280 BF 0B            [ 2]  700     ldw     *m_y+2, x
      000282                        701 00062$:
      000282 C6 00 03         [ 1]  702     ld      a, _g_yend+3            ; if y > y_end: stop accumulating
      000285 B0 0C            [ 1]  703     sub     a, *m_y+3
      000287 C6 00 02         [ 1]  704     ld      a, _g_yend+2
      00028A B2 0B            [ 1]  705     sbc     a, *m_y+2
      00028C C6 00 01         [ 1]  706     ld      a, _g_yend+1
      00028F B2 0A            [ 1]  707     sbc     a, *m_y+1
      000291 C6 00 00         [ 1]  708     ld      a, _g_yend
      000294 B2 09            [ 1]  709     sbc     a, *m_y
      000296 25 40            [ 1]  710     jrc     00070$
                                    711     ; q = (y + 256) >> 9 ; e = low16(y) - low16(q << 9)
      000298 BE 0B            [ 2]  712     ldw     x, *m_y+2
      00029A B6 0A            [ 1]  713     ld      a, *m_y+1
      00029C 1C 01 00         [ 2]  714     addw    x, #0x0100
      00029F A9 00            [ 1]  715     adc     a, #0
      0002A1 5E               [ 1]  716     swapw   x
      0002A2 95               [ 1]  717     ld      xh, a
      0002A3 54               [ 2]  718     srlw    x                   ; X = q
      0002A4 9F               [ 1]  719     ld      a, xl
      0002A5 5F               [ 1]  720     clrw    x
      0002A6 95               [ 1]  721     ld      xh, a
      0002A7 58               [ 2]  722     sllw    x                   ; X = low16(q << 9)
      0002A8 BF 03            [ 2]  723     ldw     *m_b, x
      0002AA BE 0B            [ 2]  724     ldw     x, *m_y+2
      0002AC 72 B0 00 03      [ 2]  725     subw    x, m_b              ; X = e (s16 exact)
                                    726     ; block = (y < mid_u) ? r_lo : r_hi
      0002B0 B6 0C            [ 1]  727     ld      a, *m_y+3
      0002B2 C0 00 03         [ 1]  728     sub     a, _g_ymid+3
      0002B5 B6 0B            [ 1]  729     ld      a, *m_y+2
      0002B7 C2 00 02         [ 1]  730     sbc     a, _g_ymid+2
      0002BA B6 0A            [ 1]  731     ld      a, *m_y+1
      0002BC C2 00 01         [ 1]  732     sbc     a, _g_ymid+1
      0002BF B6 09            [ 1]  733     ld      a, *m_y
      0002C1 C2 00 00         [ 1]  734     sbc     a, _g_ymid
      0002C4 25 06            [ 1]  735     jrc     00063$
      0002C6 90 AE 00 3A      [ 2]  736     ldw     y, #r_hi
      0002CA 20 04            [ 2]  737     jra     00064$
      0002CC                        738 00063$:
      0002CC 90 AE 00 30      [ 2]  739     ldw     y, #r_lo
      0002D0                        740 00064$:
      0002D0 CD 02 03         [ 4]  741     call    accum
      0002D3 20 93            [ 2]  742     jra     00061$
