      000AA7 5A               [ 2] 2084     decw    x
      000AA8 9F               [ 1] 2085     ld      a, xl
      000AA9 5F               [ 1] 2086     clrw    x
      000AAA 95               [ 1] 2087     ld      xh, a
      000AAB 58               [ 2] 2088     sllw    x
      000AAC A6 01            [ 1] 2089     ld      a, #1
      000AAE 20 06            [ 2] 2090     jra     00507$
      000AB0                       2091 00508$:
