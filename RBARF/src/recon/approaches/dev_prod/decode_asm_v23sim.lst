                                   2822 ; ======================================================================
                                   2823 ; Size-focused sample scanner: a rolled, bit-exact port of decode.c's
                                   2824 ; C scanner (the proven v1 ps_next semantics), ~350 B against scan.s's
                                   2825 ; speed-unrolled 900 B.  Slower per sample (~30 cy vs ~8); at ~11.5k
                                   2826 ; sample visits per decode that costs ~+10-15 ms on a production decode
                                   2827 ; -- traded for flash, which is the binding constraint.
                                   2828 ; ======================================================================
                                   2829 
                                   2830     .area CODE
                                   2831 
      000FB4                       2832 _scan_init:
      000FB4 5F               [ 1] 2833     clrw    x
      000FB5 BF B7            [ 2] 2834     ldw     *p_i, x
      000FB7 BF B9            [ 2] 2835     ldw     *p_tb, x
      000FB9 BF BB            [ 2] 2836     ldw     *p_ws, x
      000FBB BF BD            [ 2] 2837     ldw     *p_tp, x
      000FBD BF C6            [ 2] 2838     ldw     *p_lr, x
      000FBF 3F C1            [ 1] 2839     clr     *p_s
      000FC1 3F C2            [ 1] 2840     clr     *p_hp
      000FC3 3F C3            [ 1] 2841     clr     *p_ip
      000FC5 3F C4            [ 1] 2842     clr     *p_se
      000FC7 3F C5            [ 1] 2843     clr     *p_dn
      000FC9 81               [ 4] 2844     ret
                                   2845 
                                   2846 ; A = cap[i + A(0/1)] helper: X = p_i (+carry offset in A) -> A = byte
      000FCA                       2847 capat:                          ; X = index -> A = cap[X]
      000FCA 72 BB 00 AA      [ 2] 2848     addw    x, *_scan_cap
      000FCE F6               [ 1] 2849     ld      a, (x)
      000FCF 81               [ 4] 2850     ret
                                   2851 
