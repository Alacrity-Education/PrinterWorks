      000A93 20 02            [ 2] 2069     jra     00505$
      000A95                       2070 00504$:
      000A95 BE 7E            [ 2] 2071     ldw     x, *m_c             ; min = d1
      000A97                       2072 00505$:
      000A97 A3 00 F6         [ 2] 2073     cpw     x, #246
