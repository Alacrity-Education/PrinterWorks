      00052C 3F 5C            [ 1] 1091     clr     *r_sgn
      00052E 5D               [ 2] 1092     tnzw    x
      00052F 2A 05            [ 1] 1093     jrpl    00110$
      000531 50               [ 2] 1094     negw    x
      000532 35 01 00 5C      [ 1] 1095     mov     r_sgn, #1
      000536                       1096 00110$:
      000536 BF 01            [ 2] 1097     ldw     *m_a, x
      000538 AE 27 10         [ 2] 1098     ldw     x, #10000
      00053B BF 03            [ 2] 1099     ldw     *m_b, x
      00053D CD 00 00         [ 4] 1100     call    mul16               ; <= 75.7M
      000540 BE 05            [ 2] 1101     ldw     x, *m_p
      000542 BF 24            [ 2] 1102     ldw     *m_n, x
      000544 BE 07            [ 2] 1103     ldw     x, *m_p+2
      000546 BF 26            [ 2] 1104     ldw     *m_n+2, x
      000548 5F               [ 1] 1105     clrw    x
      000549 BF 28            [ 2] 1106     ldw     *m_d, x
      00054B BE E5            [ 2] 1107     ldw     x, *_dec_info+9
      00054D BF 2A            [ 2] 1108     ldw     *m_d+2, x
      00054F CD 01 AD         [ 4] 1109     call    udiv32
      000552 BE 26            [ 2] 1110     ldw     x, *m_n+2
      000554 3D 5C            [ 1] 1111     tnz     *r_sgn
      000556 27 01            [ 1] 1112     jreq    00111$
      000558 50               [ 2] 1113     negw    x
      000559                       1114 00111$:
      000559 81               [ 4] 1115     ret
                                   1116 
                                   1117 ; ---------------------------------------------------------- set_gap56
                                   1118 ; c_gap56[0] = (6*K)>>11, c_gap56[1] = (5*K)>>11 (both <= 175)
      00055A                       1119 _set_gap56:
      00055A A6 06            [ 1] 1120     ld      a, #6
      00055C CD 05 69         [ 4] 1121     call    gap1
      00055F BF D8            [ 2] 1122     ldw     *zgap, x
      000561 A6 05            [ 1] 1123     ld      a, #5
      000563 CD 05 69         [ 4] 1124     call    gap1
      000566 BF DA            [ 2] 1125     ldw     *zgap+2, x
      000568 81               [ 4] 1126     ret
      000569                       1127 gap1:
      000569 5F               [ 1] 1128     clrw    x
      00056A 97               [ 1] 1129     ld      xl, a
      00056B BF 01            [ 2] 1130     ldw     *m_a, x
      00056D CE 00 00         [ 2] 1131     ldw     x, _g_K
      000570 BF 03            [ 2] 1132     ldw     *m_b, x
      000572 CD 00 00         [ 4] 1133     call    mul16
      000575 CD 04 96         [ 4] 1134     call    shp11
      000578 81               [ 4] 1135     ret
                                   1136 
                                   1137 ; ======================================================================
                                   1138 ; P4 decision cluster: known_bit / a_bounds / hinge / argmin / decide /
                                   1139 ; cand_insert / decide_pass.  Replaces ~1470 B of SDCC output.
                                   1140 ; The per-bit margin scan uses an exactly-equivalent prefix-min (online)
                                   1141 ; + suffix-min (precomputed d_sm[]) formulation of the C's inner loops:
                                   1142 ;   c0m(off) = min costs[a in lo..min(off,hi)]   (empty -> 0xFFFF)
                                   1143 ;   c1m(off) = min costs[a in max(lo,off+1)..hi] (empty -> 0xFFFF)
                                   1144 ; identical values, O(L+W) instead of O(L*W).
                                   1145 ; ======================================================================
                                   1146 
                                   1147     .globl _decide_pass
                                   1148     .globl _known_bit
                                   1149     .globl _a_bounds_sg
                                   1150     .globl _g_sg
                                   1151     .globl _dq_amin
                                   1152     .globl _dq_amax
                                   1153     .globl _g_NBmHT
                                   1154     .globl _g_PPHI
                                   1155     .globl _g_ND8
                                   1156 
                                   1157     .globl _ov
                                   1158     ; decision-pass state the C pipeline tail reads (see the v2.3 note
                                   1159     ; where the hand-assembled chase used to be)
                                   1160     .globl _v_cand_t
                                   1161     .globl _v_cand_m
                                   1162     .globl _v_ncand
                                   1163     .globl _v_nweak
                                   1164     .globl _v_ndw
                                   1165     .globl _v_ntied
                                   1166     .globl _v_chkconf
                                   1167     .globl _d_infeas
                                   1168     .globl _d_laberr
                                   1169     .globl _d_nseg
                                   1170 
                                   1171     .area CODE
                                   1172 
                                   1173 ; -------------------------------------------------------------- known_bit
                                   1174 ; X = t -> A = 0 / 1 / 0xFF(-1).  C-ABI compatible (calibrate calls it).
                                   1175 ; v2.3 markers are 3+3: 24 header bits, 24 trailer bits.  The template
                                   1176 ; comes from HTR -- the BIT-REVERSED marker bytes the pipeline tail's
                                   1177 ; violation popcount also uses: wire bit (7-(t&7)) of the plain byte IS
                                   1178 ; bit (t&7) of the reversed one, so this shifts RIGHT where the old
                                   1179 ; MSB-first HT table shifted left, and ONE 6-byte table serves both.
      000579                       1180 _known_bit:
      000579 A3 00 18         [ 2] 1181     cpw     x, #24
      00057C 25 09            [ 1] 1182     jrc     00130$              ; header bits 0..23
      00057E 72 B0 00 00      [ 2] 1183     subw    x, _g_NBmHT
      000582 25 17            [ 1] 1184     jrc     00132$              ; interior
      000584 1C 00 18         [ 2] 1185     addw    x, #24              ; trailer bits at HT[24..47]
      000587                       1186 00130$:
      000587 9F               [ 1] 1187     ld      a, xl
      000588 A4 07            [ 1] 1188     and     a, #7
      00058A 4C               [ 1] 1189     inc     a
      00058B B7 0D            [ 1] 1190     ld      *m_s, a                 ; shift count = (t&7)+1
      00058D 54               [ 2] 1191     srlw    x
      00058E 54               [ 2] 1192     srlw    x
      00058F 54               [ 2] 1193     srlw    x
      000590 D6 14 81         [ 1] 1194     ld      a, (HTR, x)
      000593                       1195 00131$:
      000593 44               [ 1] 1196     srl     a
      000594 3A 0D            [ 1] 1197     dec     *m_s
      000596 26 FB            [ 1] 1198     jrne    00131$
      000598 4F               [ 1] 1199     clr     a
      000599 49               [ 1] 1200     rlc     a                       ; A = the bit
      00059A 81               [ 4] 1201     ret
      00059B                       1202 00132$:
      00059B A6 FF            [ 1] 1203     ld      a, #0xFF
      00059D 81               [ 4] 1204     ret
                                   1205 
                                   1206 ; ------------------------------------------------------------ a_bounds_sg
                                   1207 ; a_bounds over g_sg -> dq_amin/dq_amax (C calibrate uses this too).
      00059E                       1208 _a_bounds_sg:
      00059E 5F               [ 1] 1209     clrw    x
      00059F BF 66            [ 2] 1210     ldw     *_dq_amin, x
      0005A1 BE 5F            [ 2] 1211     ldw     x, *_g_sg+2
      0005A3 72 B0 00 5D      [ 2] 1212     subw    x, _g_sg
      0005A7 BF 68            [ 2] 1213     ldw     *_dq_amax, x
      0005A9 BE 5F            [ 2] 1214     ldw     x, *_g_sg+2             ; e = min(k1, NB)
      0005AB C3 00 00         [ 2] 1215     cpw     x, _g_NB
      0005AE 25 03            [ 1] 1216     jrc     00140$
      0005B0 CE 00 00         [ 2] 1217     ldw     x, _g_NB
      0005B3                       1218 00140$:
      0005B3 BF 84            [ 2] 1219     ldw     *m_e, x
      0005B5 BE 5D            [ 2] 1220     ldw     x, *_g_sg
      0005B7 BF 86            [ 2] 1221     ldw     *m_t, x
      0005B9                       1222 00141$:
      0005B9 BE 86            [ 2] 1223     ldw     x, *m_t
      0005BB B3 84            [ 2] 1224     cpw     x, *m_e
      0005BD 24 2C            [ 1] 1225     jrnc    00149$
      0005BF CD 05 79         [ 4] 1226     call    _known_bit
      0005C2 A1 01            [ 1] 1227     cp      a, #1
      0005C4 26 0F            [ 1] 1228     jrne    00142$
      0005C6 BE 86            [ 2] 1229     ldw     x, *m_t                 ; kb == 1: amin = max(amin, t-k0+1)
      0005C8 72 B0 00 5D      [ 2] 1230     subw    x, _g_sg
      0005CC 5C               [ 1] 1231     incw    x
      0005CD B3 66            [ 2] 1232     cpw     x, *_dq_amin
      0005CF 23 13            [ 2] 1233     jrule   00144$
      0005D1 BF 66            [ 2] 1234     ldw     *_dq_amin, x
      0005D3 20 0F            [ 2] 1235     jra     00144$
      0005D5                       1236 00142$:
      0005D5 4D               [ 1] 1237     tnz     a
      0005D6 26 0C            [ 1] 1238     jrne    00144$              ; -1: nothing
      0005D8 BE 86            [ 2] 1239     ldw     x, *m_t                 ; kb == 0: amax = min(amax, t-k0)
      0005DA 72 B0 00 5D      [ 2] 1240     subw    x, _g_sg
      0005DE B3 68            [ 2] 1241     cpw     x, *_dq_amax
      0005E0 24 02            [ 1] 1242     jrnc    00144$
      0005E2 BF 68            [ 2] 1243     ldw     *_dq_amax, x
      0005E4                       1244 00144$:
      0005E4 BE 86            [ 2] 1245     ldw     x, *m_t
      0005E6 5C               [ 1] 1246     incw    x
      0005E7 BF 86            [ 2] 1247     ldw     *m_t, x
      0005E9 20 CE            [ 2] 1248     jra     00141$
      0005EB                       1249 00149$:
      0005EB 81               [ 4] 1250     ret
                                   1251 
                                   1252 ; ---------------------------------------------------------------- hcost
                                   1253 ; X = h -> X = hinge(u, v, h) = max(0, u-h, h-v); g_sg.u/.v.  Keeps m_h.
      0005EC                       1254 hcost:
      0005EC BF 7A            [ 2] 1255     ldw     *m_h, x
      0005EE BE 61            [ 2] 1256     ldw     x, *_g_sg+4
      0005F0 72 B0 00 7A      [ 2] 1257     subw    x, m_h              ; u - h (s16)
      0005F4 2C 01            [ 1] 1258     jrsgt   00150$
      0005F6 5F               [ 1] 1259     clrw    x
      0005F7                       1260 00150$:
      0005F7 90 93            [ 1] 1261     ldw     y, x                    ; Y = g so far
      0005F9 BE 7A            [ 2] 1262     ldw     x, *m_h
      0005FB 72 B0 00 63      [ 2] 1263     subw    x, _g_sg+6          ; h - v (s16)
      0005FF 2C 02            [ 1] 1264     jrsgt   00151$
      000601 93               [ 1] 1265     ldw     x, y
      000602 81               [ 4] 1266     ret
      000603                       1267 00151$:
      000603 90 89            [ 2] 1268     pushw   y                   ; g
      000605 13 01            [ 2] 1269     cpw     x, (1, sp)
      000607 90 85            [ 2] 1270     popw    y
      000609 22 01            [ 1] 1271     jrugt   00152$
      00060B 93               [ 1] 1272     ldw     x, y
      00060C                       1273 00152$:
      00060C 81               [ 4] 1274     ret
                                   1275 
                                   1276 ; ----------------------------------------------------------------- itst
                                   1277 ; A = (u < m_h && m_h <= v), signed.
      00060D                       1278 itst:
      00060D BE 61            [ 2] 1279     ldw     x, *_g_sg+4
      00060F B3 7A            [ 2] 1280     cpw     x, *m_h
      000611 2F 02            [ 1] 1281     jrslt   00153$
      000613 4F               [ 1] 1282     clr     a
      000614 81               [ 4] 1283     ret
      000615                       1284 00153$:
      000615 BE 7A            [ 2] 1285     ldw     x, *m_h
      000617 B3 63            [ 2] 1286     cpw     x, *_g_sg+6
      000619 2D 02            [ 1] 1287     jrsle   00154$
      00061B 4F               [ 1] 1288     clr     a
      00061C 81               [ 4] 1289     ret
      00061D                       1290 00154$:
      00061D A6 01            [ 1] 1291     ld      a, #1
      00061F 81               [ 4] 1292     ret
                                   1293 
                                   1294 ; --------------------------------------------------------------- setbit
                                   1295 ; dq_inter |= 1 << m_ai
      000620                       1296 setbit:
      000620 B6 91            [ 1] 1297     ld      a, *m_ai
      000622 A4 07            [ 1] 1298     and     a, #7
      000624 B7 0D            [ 1] 1299     ld      *m_s, a
      000626 A6 01            [ 1] 1300     ld      a, #1
      000628 3D 0D            [ 1] 1301     tnz     *m_s
      00062A 27 05            [ 1] 1302     jreq    00156$
      00062C                       1303 00155$:
      00062C 48               [ 1] 1304     sll     a
      00062D 3A 0D            [ 1] 1305     dec     *m_s
      00062F 26 FB            [ 1] 1306     jrne    00155$
      000631                       1307 00156$:
      000631 88               [ 1] 1308     push    a
      000632 B6 91            [ 1] 1309     ld      a, *m_ai
      000634 A1 08            [ 1] 1310     cp      a, #8
      000636 84               [ 1] 1311     pop     a
      000637 25 05            [ 1] 1312     jrc     00157$
      000639 BA 6A            [ 1] 1313     or      a, *dq_inter            ; bits 8..15 live in the high byte
      00063B B7 6A            [ 1] 1314     ld      *dq_inter, a
      00063D 81               [ 4] 1315     ret
      00063E                       1316 00157$:
      00063E BA 6B            [ 1] 1317     or      a, *dq_inter+1
      000640 B7 6B            [ 1] 1318     ld      *dq_inter+1, a
      000642 81               [ 4] 1319     ret
                                   1320 
                                   1321 ; --------------------------------------------------------------- getbit
                                   1322 ; A = (dq_inter >> m_ai2) & 1
      000643                       1323 getbit:
      000643 B6 92            [ 1] 1324     ld      a, *m_ai2
      000645 A4 07            [ 1] 1325     and     a, #7
      000647 4C               [ 1] 1326     inc     a
      000648 B7 0D            [ 1] 1327     ld      *m_s, a
      00064A B6 92            [ 1] 1328     ld      a, *m_ai2
      00064C A1 08            [ 1] 1329     cp      a, #8
      00064E 25 04            [ 1] 1330     jrc     00158$
      000650 B6 6A            [ 1] 1331     ld      a, *dq_inter
      000652 20 02            [ 2] 1332     jra     00159$
      000654                       1333 00158$:
      000654 B6 6B            [ 1] 1334     ld      a, *dq_inter+1
      000656                       1335 00159$:
      000656 44               [ 1] 1336     srl     a
      000657 3A 0D            [ 1] 1337     dec     *m_s
      000659 26 FB            [ 1] 1338     jrne    00159$
      00065B 4F               [ 1] 1339     clr     a
      00065C 49               [ 1] 1340     rlc     a
      00065D 81               [ 4] 1341     ret
                                   1342 
                                   1343 ; --------------------------------------------------------------- argmin
                                   1344 ; over [m_alo..m_ahi]: (cost, interior-preferred-on-tie, smallest a).
                                   1345 ; -> X = best.  Mirrors C argmin_ab exactly (bc=0xFFFF, bi=1 initial).
      00065E                       1346 argmin:
      00065E AE FF FF         [ 2] 1347     ldw     x, #0xFFFF
      000661 BF 7E            [ 2] 1348     ldw     *m_c, x
      000663 35 01 00 90      [ 1] 1349     mov     m_it, #1
      000667 B6 93            [ 1] 1350     ld      a, *m_alo
      000669 B7 95            [ 1] 1351     ld      *m_best, a
      00066B B7 92            [ 1] 1352     ld      *m_ai2, a
      00066D                       1353 00160$:
      00066D B6 92            [ 1] 1354     ld      a, *m_ai2
      00066F 48               [ 1] 1355     sll     a
      000670 5F               [ 1] 1356     clrw    x
      000671 97               [ 1] 1357     ld      xl, a
      000672 DE 00 00         [ 2] 1358     ldw     x, (_d_costs, x)
      000675 B3 7E            [ 2] 1359     cpw     x, *m_c
      000677 25 16            [ 1] 1360     jrc     00161$              ; strictly better
      000679 26 1F            [ 1] 1361     jrne    00163$              ; worse
      00067B CD 06 43         [ 4] 1362     call    getbit              ; equal: take iff it && !bi
      00067E 4D               [ 1] 1363     tnz     a
      00067F 27 19            [ 1] 1364     jreq    00163$
      000681 3D 90            [ 1] 1365     tnz     *m_it
      000683 26 15            [ 1] 1366     jrne    00163$
      000685 35 01 00 90      [ 1] 1367     mov     m_it, #1
      000689 B6 92            [ 1] 1368     ld      a, *m_ai2
      00068B B7 95            [ 1] 1369     ld      *m_best, a
      00068D 20 0B            [ 2] 1370     jra     00163$
      00068F                       1371 00161$:
      00068F BF 7E            [ 2] 1372     ldw     *m_c, x
      000691 CD 06 43         [ 4] 1373     call    getbit
      000694 B7 90            [ 1] 1374     ld      *m_it, a
      000696 B6 92            [ 1] 1375     ld      a, *m_ai2
      000698 B7 95            [ 1] 1376     ld      *m_best, a
      00069A                       1377 00163$:
      00069A B6 92            [ 1] 1378     ld      a, *m_ai2
      00069C 4C               [ 1] 1379     inc     a
      00069D B7 92            [ 1] 1380     ld      *m_ai2, a
      00069F B1 94            [ 1] 1381     cp      a, *m_ahi
      0006A1 23 CA            [ 2] 1382     jrule   00160$
      0006A3 5F               [ 1] 1383     clrw    x
      0006A4 B6 95            [ 1] 1384     ld      a, *m_best
      0006A6 97               [ 1] 1385     ld      xl, a
      0006A7 81               [ 4] 1386     ret
                                   1387 
                                   1388 ; --------------------------------------------------------------- addd56
                                   1389 ; m_h0 += sext(A); m_h1 += sext(A)
      0006A8                       1390 addd56:
      0006A8 5F               [ 1] 1391     clrw    x
      0006A9 97               [ 1] 1392     ld      xl, a
      0006AA 4D               [ 1] 1393     tnz     a
      0006AB 2A 03            [ 1] 1394     jrpl    00165$
      0006AD 1C FF 00         [ 2] 1395     addw    x, #0xFF00
      0006B0                       1396 00165$:
      0006B0 BF 7A            [ 2] 1397     ldw     *m_h, x
      0006B2 BE 76            [ 2] 1398     ldw     x, *m_h0
      0006B4 72 BB 00 7A      [ 2] 1399     addw    x, m_h
      0006B8 BF 76            [ 2] 1400     ldw     *m_h0, x
      0006BA BE 78            [ 2] 1401     ldw     x, *m_h1
      0006BC 72 BB 00 7A      [ 2] 1402     addw    x, m_h
      0006C0 BF 78            [ 2] 1403     ldw     *m_h1, x
      0006C2 81               [ 4] 1404     ret
                                   1405 
                                   1406 ; ---------------------------------------------------------------- decide
                                   1407 ; g_sg -> d_costs[0..acap], dq_inter, dq_acap/afree/lo/hi/ahat.
      0006C3                       1408 dq_decide:
      0006C3 BE 5F            [ 2] 1409     ldw     x, *_g_sg+2
      0006C5 72 B0 00 5D      [ 2] 1410     subw    x, _g_sg
      0006C9 BF 7C            [ 2] 1411     ldw     *m_L, x                 ; L = k1-k0 (>= 1)
      0006CB A3 00 10         [ 2] 1412     cpw     x, #16
      0006CE 25 03            [ 1] 1413     jrc     00170$
      0006D0 AE 00 0F         [ 2] 1414     ldw     x, #15
      0006D3                       1415 00170$:
      0006D3 BF 6C            [ 2] 1416     ldw     *dq_acap, x
      0006D5 BE D2            [ 2] 1417     ldw     x, *zh0c
      0006D7 BF 76            [ 2] 1418     ldw     *m_h0, x
      0006D9 BE D4            [ 2] 1419     ldw     x, *zh1c
      0006DB BF 78            [ 2] 1420     ldw     *m_h1, x
      0006DD B6 65            [ 1] 1421     ld      a, *_g_sg+8             ; fam
      0006DF A1 05            [ 1] 1422     cp      a, #5
      0006E1 26 07            [ 1] 1423     jrne    00171$
      0006E3 B6 D6            [ 1] 1424     ld      a, *zd56
      0006E5 CD 06 A8         [ 4] 1425     call    addd56
      0006E8 20 09            [ 2] 1426     jra     00172$
      0006EA                       1427 00171$:
      0006EA A1 06            [ 1] 1428     cp      a, #6
      0006EC 26 05            [ 1] 1429     jrne    00172$
      0006EE B6 D7            [ 1] 1430     ld      a, *zd56+1
      0006F0 CD 06 A8         [ 4] 1431     call    addd56
      0006F3                       1432 00172$:
      0006F3 5F               [ 1] 1433     clrw    x
      0006F4 BF 6A            [ 2] 1434     ldw     *dq_inter, x
      0006F6 3F 91            [ 1] 1435     clr     *m_ai
      0006F8                       1436 00173$:                         ; per hypothesis a
      0006F8 B6 91            [ 1] 1437     ld      a, *m_ai
      0006FA 26 0E            [ 1] 1438     jrne    00174$
      0006FC BE 76            [ 2] 1439     ldw     x, *m_h0                ; a == 0
      0006FE CD 05 EC         [ 4] 1440     call    hcost
      000701 BF 7E            [ 2] 1441     ldw     *m_c, x
      000703 CD 06 0D         [ 4] 1442     call    itst
      000706 B7 90            [ 1] 1443     ld      *m_it, a
      000708 20 38            [ 2] 1444     jra     00177$
      00070A                       1445 00174$:
      00070A 4A               [ 1] 1446     dec     a                       ; a >= 1: h = (a-1)*512 + h1e
      00070B 48               [ 1] 1447     sll     a
      00070C 5F               [ 1] 1448     clrw    x
      00070D 95               [ 1] 1449     ld      xh, a
      00070E 72 BB 00 78      [ 2] 1450     addw    x, m_h1
      000712 CD 05 EC         [ 4] 1451     call    hcost
      000715 BF 7E            [ 2] 1452     ldw     *m_c, x
      000717 CD 06 0D         [ 4] 1453     call    itst
      00071A B7 90            [ 1] 1454     ld      *m_it, a
      00071C B6 91            [ 1] 1455     ld      a, *m_ai                ; if a < L: h2 = a*512 + h0e
      00071E 5F               [ 1] 1456     clrw    x
      00071F 97               [ 1] 1457     ld      xl, a
      000720 B3 7C            [ 2] 1458     cpw     x, *m_L
      000722 24 1E            [ 1] 1459     jrnc    00177$
      000724 B6 91            [ 1] 1460     ld      a, *m_ai
      000726 48               [ 1] 1461     sll     a
      000727 5F               [ 1] 1462     clrw    x
      000728 95               [ 1] 1463     ld      xh, a
      000729 72 BB 00 76      [ 2] 1464     addw    x, m_h0
      00072D CD 05 EC         [ 4] 1465     call    hcost
      000730 89               [ 2] 1466     pushw   x
      000731 CD 06 0D         [ 4] 1467     call    itst
      000734 4D               [ 1] 1468     tnz     a
      000735 27 04            [ 1] 1469     jreq    00175$
      000737 35 01 00 90      [ 1] 1470     mov     m_it, #1
      00073B                       1471 00175$:
      00073B 85               [ 2] 1472     popw    x
      00073C B3 7E            [ 2] 1473     cpw     x, *m_c
      00073E 24 02            [ 1] 1474     jrnc    00177$
      000740 BF 7E            [ 2] 1475     ldw     *m_c, x
      000742                       1476 00177$:                         ; store costs[a] + interior bit
      000742 B6 91            [ 1] 1477     ld      a, *m_ai
      000744 48               [ 1] 1478     sll     a
      000745 5F               [ 1] 1479     clrw    x
      000746 97               [ 1] 1480     ld      xl, a
      000747 90 BE 7E         [ 2] 1481     ldw     y, *m_c
      00074A DF 00 00         [ 2] 1482     ldw     (_d_costs, x), y
      00074D 3D 90            [ 1] 1483     tnz     *m_it
      00074F 27 03            [ 1] 1484     jreq    00178$
      000751 CD 06 20         [ 4] 1485     call    setbit
      000754                       1486 00178$:
      000754 B6 91            [ 1] 1487     ld      a, *m_ai
