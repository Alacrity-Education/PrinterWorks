                                   3291 ; -------------------------------------------------------------- putval
                                   3292 ; A = value, *z_q = rank r -> ch_val[3*z_bs + r] = A
      0011FF                       3293 putval:
      0011FF B7 0D            [ 1] 3294     ld      *m_s, a
