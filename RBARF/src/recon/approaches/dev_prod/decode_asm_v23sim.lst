      0004B9 26 0A            [ 1] 1024     jrne    00102$
      0004BB CE 00 AE         [ 2] 1025     ldw     x, _scan_ra             ; first pulse: r0m = (ra + rb) >> 1
      0004BE 72 BB 00 B0      [ 2] 1026     addw    x, _scan_rb
