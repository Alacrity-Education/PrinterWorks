                                      1 ; scan.s -- hand-assembly sample scanner for the v2.1 decoder hot path
                                      2 ; (STM8S001J3, SDCC calling convention, sdcccall(1): result in A;
                                      3 ;  A/X/Y caller-saved).
                                      4 ;
                                      5 ; Replaces decode.c's C scanner (v1 ps_next measured 798 B flash and
                                      6 ; ~200 ucsim ticks per sample visit -- EMBEDDED_FEASIBILITY.md SS6).
                                      7 ; This is the "tight assembly" projection of that report: documented
                                      8 ; cycle counts are annotated per block below; real silicon runs ~7%
                                      9 ; slower than the documented/ucsim numbers on this instruction mix
                                     10 ; (calibrated against the crystal-exact capture loop), and the on-chip
                                     11 ; TIM1 measurement in rbarf_v21.c (TIM:<ticks> line, 16 us/tick) is the
                                     12 ; authoritative figure.
                                     13 ;
                                     14 ; CONTRACT (bit-exact vs recon/approaches/embedded_v2.py _pulse_stream,
                                     15 ; proven by recon/approaches/dev_fw/ ucsim parity):
                                     16 ;   scan_cap/scan_len  in : capture buffer (cap_code.s byte layout), bytes
                                     17 ;   scan_init()             reset stream state
                                     18 ;   scan_next() -> A=1      pulse out: scan_ra/rb/fa/fb (u16 cycles),
                                     19 ;                           scan_sfa (slot of last high sample)
                                     20 ;                A=0        stream end (latch run seen, or data exhausted)
                                     21 ;
                                     22 ; Capture byte layout (DATASET.md): byte i bits5..0 = R0..R5 of loop i,
                                     23 ; byte i+1 bits7..6 = BS0,BS1 of loop i.  The scanner composes one
                                     24 ; loop-aligned octet A = (byte[i]<<2)|(byte[i+1]>>6), MSB-first
                                     25 ; chronological = R0,R1,R2,R3,R4,R5,BS0,BS1, and walks it with an
                                     26 ; unrolled 8-slot state machine, two modes (low/high).
                                     27 ;
                                     28 ; Fitted sampler model (integer cycles, dev_calibration/fitted_model):
                                     29 ;   slot offsets O = [0,4,9,13,17,21,27,32], loop = 40 cy
                                     30 ;   inter-sample gaps  GAP  = [4,5,4,4,4,6,5,8]      (slot j -> j+1)
                                     31 ;   +data-dependent    W    = [0,-1,0,+2,0,0,0,+1]   (added when HIGH)
                                     32 ;   high-sample gaps   GAPW = [4,4,4,6,4,6,5,9]      (GAP+W)
                                     33 ; Time t is carried incrementally in X (u16 CPU cycles): no multiplies.
                                     34 ; ra of a rise = t - GAP[prev slot] (previous sample was low); fa/sfa of
                                     35 ; a fall = derived from t - GAPW[prev slot] (previous sample was high):
                                     36 ; the hot loops store NOTHING per sample.
                                     37 ;
                                     38 ; Latch: 200 consecutive low samples end the stream (down-counter; the
                                     39 ; whole-octet fast path subtracts 8 -- an intra-octet trigger returns at
                                     40 ; the octet end, which is observably identical: no pulses in between).
                                     41 ; The Python reference arms the latch only after the first pulse ("seen");
                                     42 ; the capture is edge-triggered so a 200-low run before the first pulse
                                     43 ; cannot occur (measured: max leading-low run over all 240 real captures
                                     44 ; = 0 samples), and this scanner omits the flag.  Guard: scan_len >= 2
                                     45 ; (decode is always called with a 256..640-byte buffer).
                                     46 ;
                                     47 ; Whole-octet fast paths (exact, same accounting as v1 decoder.c):
                                     48 ;   octet 0x00 in low mode:  t += 40, latch -= 8      (idle / latch tail)
                                     49 ;   octet 0xFF in high mode: t += 42 (40 + W-sum 2)   (long pulses)
                                     50 ;
                                     51 ; DISPATCH: scan_next resumes mid-octet after each emitted pulse via a
                                     52 ; 9-entry jump table indexed by s_res: 0=fetch, 1..7=low slot, 8=done.
                                     53 ; (Falls resume in low mode by construction; entry 6 checks the 6-bit
                                     54 ; tail octet's end.)
                                     55 
                                     56     .module scan
                                     57     .globl _scan_cap
                                     58     .globl _scan_len
                                     59     .globl _scan_ra
                                     60     .globl _scan_rb
                                     61     .globl _scan_fa
                                     62     .globl _scan_fb
                                     63     .globl _scan_sfa
                                     64     .globl _scan_init
                                     65     .globl _scan_next
                                     66     .globl _cap_capture
                                     67     .globl _cap_loop
                                     68 
                                     69 ; ---------------------------------------------------------------- state
                                     70     .area DATA
                                     71 
      000000                         72 _scan_cap:  .ds 2       ; in: capture pointer
      000002                         73 _scan_len:  .ds 2       ; in: capture bytes (= loops)
      000004                         74 _scan_ra:   .ds 2       ; out: rise bracket lo (cycles)
      000006                         75 _scan_rb:   .ds 2       ; out: rise bracket hi
      000008                         76 _scan_fa:   .ds 2       ; out: last-high time
      00000A                         77 _scan_fb:   .ds 2       ; out: fall bracket hi
      00000C                         78 _scan_sfa:  .ds 1       ; out: slot of last high sample (family id)
      00000D                         79 s_ptr:      .ds 2       ; next R-byte
      00000F                         80 s_left:     .ds 2       ; full octets remaining after the current one
      000011                         81 s_t:        .ds 2       ; saved t between calls
      000013                         82 s_oct:      .ds 1       ; saved octet shift register
      000014                         83 s_res:      .ds 1       ; resume index 0..8
      000015                         84 s_latch:    .ds 1       ; latch down-counter (200 low samples)
      000016                         85 s_tail:     .ds 1       ; processing the final 6-sample octet
                                     86 
                                     87     .area CODE
                                     88 
                                     89 ; ---------------------------------------------------------------- init
      000000                         90 _scan_init:
      000000 CE 00 00         [ 2]   91     ldw     x, _scan_cap
      000003 CF 00 0D         [ 2]   92     ldw     s_ptr, x
      000006 72 5F 00 16      [ 1]   93     clr     s_tail
      00000A 72 5F 00 13      [ 1]   94     clr     s_oct
      00000E 35 C8 00 15      [ 1]   95     mov     s_latch, #200
      000012 5F               [ 1]   96     clrw    x
      000013 CF 00 11         [ 2]   97     ldw     s_t, x
      000016 CE 00 02         [ 2]   98     ldw     x, _scan_len
      000019 27 09            [ 1]   99     jreq    00001$              ; len == 0 -> immediately done
      00001B 5A               [ 2]  100     decw    x
      00001C CF 00 0F         [ 2]  101     ldw     s_left, x           ; octets with a following BS byte
      00001F 35 00 00 14      [ 1]  102     mov     s_res, #0
      000023 81               [ 4]  103     ret
      000024                        104 00001$:
      000024 35 08 00 14      [ 1]  105     mov     s_res, #8
      000028 81               [ 4]  106     ret
                                    107 
                                    108 ; ------------------------------------------------------------- dispatch
                                    109 ; call(4) + 9 cy documented to reach the resume point
      000029                        110 _scan_next:
      000029 5F               [ 1]  111     clrw    x
      00002A C6 00 14         [ 1]  112     ld      a, s_res
      00002D 48               [ 1]  113     sll     a
      00002E 97               [ 1]  114     ld      xl, a
      00002F DE 00 3C         [ 2]  115     ldw     x, (jtab, x)
      000032 90 93            [ 1]  116     ldw     y, x
      000034 CE 00 11         [ 2]  117     ldw     x, s_t              ; X = t
      000037 C6 00 13         [ 1]  118     ld      a, s_oct            ; A = octet register
      00003A 90 FC            [ 2]  119     jp      (y)
                                    120 
      00003C                        121 jtab:
      00003C 00 74                  122     .dw     fetch_low           ; 0: octet boundary, low
      00003E 00 A9                  123     .dw     low1                ; 1..7: resume at low slot J
      000040 00 B5                  124     .dw     low2
      000042 00 C1                  125     .dw     low3
      000044 00 CD                  126     .dw     low4
      000046 00 D9                  127     .dw     low5
      000048 00 50                  128     .dw     resume6             ; 6: guarded (tail octet has no slot 6)
      00004A 00 F7                  129     .dw     low7
      00004C 00 4E                  130     .dw     done_e              ; 8: stream ended
                                    131 
      00004E                        132 done_e:
      00004E 4F               [ 1]  133     clr     a
      00004F 81               [ 4]  134     ret
                                    135 
      000050                        136 resume6:
      000050 72 5D 00 16      [ 1]  137     tnz     s_tail
      000054 27 03            [ 1]  138     jreq    00002$
      000056 CC 03 61         [ 2]  139     jp      end_low_tail
      000059                        140 00002$:
      000059 CC 00 EB         [ 2]  141     jp      low6
                                    142 
                                    143 ; ------------------------------------- low mode: octet fetch + fast path
      00005C                        144 tl_low:
      00005C CC 03 43         [ 2]  145     jp      tail_low
                                    146 
                                    147 ; all-low octet: 8 samples skipped -- 9 cy documented
      00005F                        148 fast_low0:
      00005F 1C 00 28         [ 2]  149     addw    x, #40              ; t += LOOP_CY (no W: all low)
      000062 C6 00 15         [ 1]  150     ld      a, s_latch
      000065 A0 08            [ 1]  151     sub     a, #8
      000067 C7 00 15         [ 1]  152     ld      s_latch, a
      00006A 23 02            [ 2]  153     jrule   00003$              ; latch run complete (seen: see header)
      00006C 20 06            [ 2]  154     jra     fetch_low
      00006E                        155 00003$:
      00006E 35 08 00 14      [ 1]  156     mov     s_res, #8
      000072 4F               [ 1]  157     clr     a
      000073 81               [ 4]  158     ret
                                    159 
                                    160 ; compose next octet -- 22 cy documented (2.75 cy/sample)
      000074                        161 fetch_low:
      000074 90 CE 00 0F      [ 2]  162     ldw     y, s_left
      000078 27 E2            [ 1]  163     jreq    tl_low              ; no BS byte left -> 6-bit tail
      00007A 90 5A            [ 2]  164     decw    y
      00007C 90 CF 00 0F      [ 2]  165     ldw     s_left, y
      000080 90 CE 00 0D      [ 2]  166     ldw     y, s_ptr
      000084 90 F6            [ 1]  167     ld      a, (y)              ; byte i  (R0..R5 in bits 5..0)
      000086 90 5C            [ 1]  168     incw    y
      000088 90 CF 00 0D      [ 2]  169     ldw     s_ptr, y
      00008C 48               [ 1]  170     sll     a
      00008D 48               [ 1]  171     sll     a
      00008E C7 00 13         [ 1]  172     ld      s_oct, a
      000091 90 F6            [ 1]  173     ld      a, (y)              ; byte i+1 (BS0,BS1 in bits 7..6)
      000093 4E               [ 1]  174     swap    a
      000094 44               [ 1]  175     srl     a
      000095 44               [ 1]  176     srl     a
      000096 A4 03            [ 1]  177     and     a, #0x03
      000098 CA 00 13         [ 1]  178     or      a, s_oct            ; A = R0..R5,BS0,BS1 MSB-first
      00009B 27 C2            [ 1]  179     jreq    fast_low0
                                    180     ; fallthrough -> low0
                                    181 
                                    182 ; ------------------------------------------------- low mode, slots 0..7
                                    183 ; per low sample: sll(1) jrc(1) addw(2) dec(1) jreq(1) = 6 cy documented
      00009D                        184 low0:
      00009D 48               [ 1]  185     sll     a
      00009E 25 66            [ 1]  186     jrc     rt0
      0000A0 1C 00 04         [ 2]  187     addw    x, #4
      0000A3 72 5A 00 15      [ 1]  188     dec     s_latch
      0000A7 27 75            [ 1]  189     jreq    latch_end
      0000A9                        190 low1:
      0000A9 48               [ 1]  191     sll     a
      0000AA 25 5D            [ 1]  192     jrc     rt1
      0000AC 1C 00 05         [ 2]  193     addw    x, #5
      0000AF 72 5A 00 15      [ 1]  194     dec     s_latch
      0000B3 27 69            [ 1]  195     jreq    latch_end
      0000B5                        196 low2:
      0000B5 48               [ 1]  197     sll     a
      0000B6 25 54            [ 1]  198     jrc     rt2
      0000B8 1C 00 04         [ 2]  199     addw    x, #4
      0000BB 72 5A 00 15      [ 1]  200     dec     s_latch
      0000BF 27 5D            [ 1]  201     jreq    latch_end
      0000C1                        202 low3:
      0000C1 48               [ 1]  203     sll     a
      0000C2 25 4B            [ 1]  204     jrc     rt3
      0000C4 1C 00 04         [ 2]  205     addw    x, #4
      0000C7 72 5A 00 15      [ 1]  206     dec     s_latch
      0000CB 27 51            [ 1]  207     jreq    latch_end
      0000CD                        208 low4:
      0000CD 48               [ 1]  209     sll     a
      0000CE 25 42            [ 1]  210     jrc     rt4
      0000D0 1C 00 04         [ 2]  211     addw    x, #4
      0000D3 72 5A 00 15      [ 1]  212     dec     s_latch
      0000D7 27 45            [ 1]  213     jreq    latch_end
      0000D9                        214 low5:
      0000D9 48               [ 1]  215     sll     a
      0000DA 25 39            [ 1]  216     jrc     rt5
      0000DC 1C 00 06         [ 2]  217     addw    x, #6
      0000DF 72 5A 00 15      [ 1]  218     dec     s_latch
      0000E3 27 39            [ 1]  219     jreq    latch_end
      0000E5 72 5D 00 16      [ 1]  220     tnz     s_tail              ; tail octet ends after slot 5
      0000E9 26 39            [ 1]  221     jrne    el_t
      0000EB                        222 low6:
      0000EB 48               [ 1]  223     sll     a
      0000EC 25 2A            [ 1]  224     jrc     rt6
      0000EE 1C 00 05         [ 2]  225     addw    x, #5
      0000F1 72 5A 00 15      [ 1]  226     dec     s_latch
      0000F5 27 27            [ 1]  227     jreq    latch_end
      0000F7                        228 low7:
      0000F7 48               [ 1]  229     sll     a
      0000F8 25 21            [ 1]  230     jrc     rt7
      0000FA 1C 00 08         [ 2]  231     addw    x, #8
      0000FD 72 5A 00 15      [ 1]  232     dec     s_latch
      000101 27 1B            [ 1]  233     jreq    latch_end
      000103 CC 00 74         [ 2]  234     jp      fetch_low
                                    235 
                                    236 ; rise trampolines (keep the jrc targets in relative range)
      000106 CC 01 27         [ 2]  237 rt0: jp     rise0
      000109 CC 01 42         [ 2]  238 rt1: jp     rise1
      00010C CC 01 59         [ 2]  239 rt2: jp     rise2
      00010F CC 01 70         [ 2]  240 rt3: jp     rise3
      000112 CC 01 87         [ 2]  241 rt4: jp     rise4
      000115 CC 01 9E         [ 2]  242 rt5: jp     rise5
      000118 CC 01 B5         [ 2]  243 rt6: jp     rise6
      00011B CC 01 CC         [ 2]  244 rt7: jp     rise7
                                    245 
      00011E                        246 latch_end:                      ; 200 consecutive lows: stream over
      00011E 35 08 00 14      [ 1]  247     mov     s_res, #8
      000122 4F               [ 1]  248     clr     a
      000123 81               [ 4]  249     ret
                                    250 
      000124                        251 el_t:
      000124 CC 03 61         [ 2]  252     jp      end_low_tail
                                    253 
                                    254 ; --------------------------------------------------------- rise sites
                                    255 ; sample at slot J is the first high of a pulse (low mode, C=1):
                                    256 ;   ra = t - GAP[J-1]  (previous sample was low), rb = t, latch reset,
                                    257 ;   t += GAPW[J], continue in high mode at slot J+1.   ~12 cy documented
      000127                        258 rise0:
      000127 90 93            [ 1]  259     ldw     y, x
      000129 72 A2 00 08      [ 2]  260     subw    y, #8               ; GAP[7]
      00012D 24 02            [ 1]  261     jrnc    00004$
      00012F 90 5F            [ 1]  262     clrw    y                   ; first sample of the capture (t = 0):
      000131                        263 00004$:                         ; ra = max(t - FIRST_BR, 0) = 0
      000131 90 CF 00 04      [ 2]  264     ldw     _scan_ra, y
      000135 CF 00 06         [ 2]  265     ldw     _scan_rb, x
      000138 35 C8 00 15      [ 1]  266     mov     s_latch, #200
      00013C 1C 00 04         [ 2]  267     addw    x, #4               ; GAPW[0]
      00013F CC 02 1C         [ 2]  268     jp      hi1
      000142                        269 rise1:
      000142 90 93            [ 1]  270     ldw     y, x
      000144 72 A2 00 04      [ 2]  271     subw    y, #4               ; GAP[0]
      000148 90 CF 00 04      [ 2]  272     ldw     _scan_ra, y
      00014C CF 00 06         [ 2]  273     ldw     _scan_rb, x
      00014F 35 C8 00 15      [ 1]  274     mov     s_latch, #200
      000153 1C 00 04         [ 2]  275     addw    x, #4               ; GAPW[1]
      000156 CC 02 22         [ 2]  276     jp      hi2
      000159                        277 rise2:
      000159 90 93            [ 1]  278     ldw     y, x
      00015B 72 A2 00 05      [ 2]  279     subw    y, #5               ; GAP[1]
      00015F 90 CF 00 04      [ 2]  280     ldw     _scan_ra, y
      000163 CF 00 06         [ 2]  281     ldw     _scan_rb, x
      000166 35 C8 00 15      [ 1]  282     mov     s_latch, #200
      00016A 1C 00 04         [ 2]  283     addw    x, #4               ; GAPW[2]
      00016D CC 02 28         [ 2]  284     jp      hi3
      000170                        285 rise3:
      000170 90 93            [ 1]  286     ldw     y, x
      000172 72 A2 00 04      [ 2]  287     subw    y, #4               ; GAP[2]
      000176 90 CF 00 04      [ 2]  288     ldw     _scan_ra, y
      00017A CF 00 06         [ 2]  289     ldw     _scan_rb, x
      00017D 35 C8 00 15      [ 1]  290     mov     s_latch, #200
      000181 1C 00 06         [ 2]  291     addw    x, #6               ; GAPW[3]
      000184 CC 02 2E         [ 2]  292     jp      hi4
      000187                        293 rise4:
      000187 90 93            [ 1]  294     ldw     y, x
      000189 72 A2 00 04      [ 2]  295     subw    y, #4               ; GAP[3]
      00018D 90 CF 00 04      [ 2]  296     ldw     _scan_ra, y
      000191 CF 00 06         [ 2]  297     ldw     _scan_rb, x
      000194 35 C8 00 15      [ 1]  298     mov     s_latch, #200
      000198 1C 00 04         [ 2]  299     addw    x, #4               ; GAPW[4]
      00019B CC 02 34         [ 2]  300     jp      hi5
      00019E                        301 rise5:
      00019E 90 93            [ 1]  302     ldw     y, x
      0001A0 72 A2 00 04      [ 2]  303     subw    y, #4               ; GAP[4]
      0001A4 90 CF 00 04      [ 2]  304     ldw     _scan_ra, y
      0001A8 CF 00 06         [ 2]  305     ldw     _scan_rb, x
      0001AB 35 C8 00 15      [ 1]  306     mov     s_latch, #200
      0001AF 1C 00 06         [ 2]  307     addw    x, #6               ; GAPW[5]
      0001B2 CC 02 40         [ 2]  308     jp      hi6
      0001B5                        309 rise6:
      0001B5 90 93            [ 1]  310     ldw     y, x
      0001B7 72 A2 00 06      [ 2]  311     subw    y, #6               ; GAP[5]
      0001BB 90 CF 00 04      [ 2]  312     ldw     _scan_ra, y
      0001BF CF 00 06         [ 2]  313     ldw     _scan_rb, x
      0001C2 35 C8 00 15      [ 1]  314     mov     s_latch, #200
      0001C6 1C 00 05         [ 2]  315     addw    x, #5               ; GAPW[6]
      0001C9 CC 02 46         [ 2]  316     jp      hi7
      0001CC                        317 rise7:
      0001CC 90 93            [ 1]  318     ldw     y, x
      0001CE 72 A2 00 05      [ 2]  319     subw    y, #5               ; GAP[6]
      0001D2 90 CF 00 04      [ 2]  320     ldw     _scan_ra, y
      0001D6 CF 00 06         [ 2]  321     ldw     _scan_rb, x
      0001D9 35 C8 00 15      [ 1]  322     mov     s_latch, #200
      0001DD 1C 00 09         [ 2]  323     addw    x, #9               ; GAPW[7]
      0001E0 CC 01 EB         [ 2]  324     jp      fetch_high
                                    325 
                                    326 ; ------------------------------------ high mode: octet fetch + fast path
      0001E3                        327 th_high:
      0001E3 CC 03 52         [ 2]  328     jp      tail_high
                                    329 
                                    330 ; all-high octet: 8 samples skipped -- 4 cy documented
      0001E6                        331 fast_high:
      0001E6 1C 00 2A         [ 2]  332     addw    x, #42              ; t += LOOP_CY + W-sum(2)
      0001E9 20 00            [ 2]  333     jra     fetch_high
                                    334 
      0001EB                        335 fetch_high:
      0001EB 90 CE 00 0F      [ 2]  336     ldw     y, s_left
      0001EF 27 F2            [ 1]  337     jreq    th_high
      0001F1 90 5A            [ 2]  338     decw    y
      0001F3 90 CF 00 0F      [ 2]  339     ldw     s_left, y
      0001F7 90 CE 00 0D      [ 2]  340     ldw     y, s_ptr
      0001FB 90 F6            [ 1]  341     ld      a, (y)
      0001FD 90 5C            [ 1]  342     incw    y
      0001FF 90 CF 00 0D      [ 2]  343     ldw     s_ptr, y
      000203 48               [ 1]  344     sll     a
      000204 48               [ 1]  345     sll     a
      000205 C7 00 13         [ 1]  346     ld      s_oct, a
      000208 90 F6            [ 1]  347     ld      a, (y)
      00020A 4E               [ 1]  348     swap    a
      00020B 44               [ 1]  349     srl     a
      00020C 44               [ 1]  350     srl     a
      00020D A4 03            [ 1]  351     and     a, #0x03
      00020F CA 00 13         [ 1]  352     or      a, s_oct
      000212 A1 FF            [ 1]  353     cp      a, #0xFF
      000214 27 D0            [ 1]  354     jreq    fast_high
                                    355     ; fallthrough -> hi0
                                    356 
                                    357 ; ------------------------------------------------- high mode, slots 0..7
                                    358 ; per high sample: sll(1) jrnc(1) addw(2) = 4 cy documented
      000216                        359 hi0:
      000216 48               [ 1]  360     sll     a
      000217 24 36            [ 1]  361     jrnc    ft0
      000219 1C 00 04         [ 2]  362     addw    x, #4
      00021C                        363 hi1:
      00021C 48               [ 1]  364     sll     a
      00021D 24 33            [ 1]  365     jrnc    ft1
      00021F 1C 00 04         [ 2]  366     addw    x, #4
      000222                        367 hi2:
      000222 48               [ 1]  368     sll     a
      000223 24 30            [ 1]  369     jrnc    ft2
      000225 1C 00 04         [ 2]  370     addw    x, #4
      000228                        371 hi3:
      000228 48               [ 1]  372     sll     a
      000229 24 2D            [ 1]  373     jrnc    ft3
      00022B 1C 00 06         [ 2]  374     addw    x, #6
      00022E                        375 hi4:
      00022E 48               [ 1]  376     sll     a
      00022F 24 2A            [ 1]  377     jrnc    ft4
      000231 1C 00 04         [ 2]  378     addw    x, #4
      000234                        379 hi5:
      000234 48               [ 1]  380     sll     a
      000235 24 27            [ 1]  381     jrnc    ft5
      000237 1C 00 06         [ 2]  382     addw    x, #6
      00023A 72 5D 00 16      [ 1]  383     tnz     s_tail              ; tail octet ends after slot 5
      00023E 26 27            [ 1]  384     jrne    eh_t
      000240                        385 hi6:
      000240 48               [ 1]  386     sll     a
      000241 24 1E            [ 1]  387     jrnc    ft6
      000243 1C 00 05         [ 2]  388     addw    x, #5
      000246                        389 hi7:
      000246 48               [ 1]  390     sll     a
      000247 24 1B            [ 1]  391     jrnc    ft7
      000249 1C 00 09         [ 2]  392     addw    x, #9
      00024C CC 01 EB         [ 2]  393     jp      fetch_high
                                    394 
                                    395 ; fall trampolines
      00024F CC 02 6A         [ 2]  396 ft0: jp     fall0
      000252 CC 02 83         [ 2]  397 ft1: jp     fall1
      000255 CC 02 9C         [ 2]  398 ft2: jp     fall2
      000258 CC 02 B5         [ 2]  399 ft3: jp     fall3
      00025B CC 02 CE         [ 2]  400 ft4: jp     fall4
      00025E CC 02 E7         [ 2]  401 ft5: jp     fall5
      000261 CC 03 00         [ 2]  402 ft6: jp     fall6
      000264 CC 03 19         [ 2]  403 ft7: jp     fall7
                                    404 
      000267                        405 eh_t:
      000267 CC 03 67         [ 2]  406     jp      end_high_tail
                                    407 
                                    408 ; ---------------------------------------------------------- fall sites
                                    409 ; sample at slot J is low, ending the pulse (high mode, C=0):
                                    410 ;   fa = t - GAPW[J-1], sfa = J-1 (previous sample was the last high),
                                    411 ;   fb = t, t += GAP[J], low_run = 1 (latch 199), save state, return 1.
                                    412 ;   ~22 cy documented incl. the shared epilogue
      00026A                        413 fall0:
      00026A 90 93            [ 1]  414     ldw     y, x
      00026C 72 A2 00 09      [ 2]  415     subw    y, #9               ; GAPW[7]
      000270 90 CF 00 08      [ 2]  416     ldw     _scan_fa, y
      000274 CF 00 0A         [ 2]  417     ldw     _scan_fb, x
      000277 35 07 00 0C      [ 1]  418     mov     _scan_sfa, #7
      00027B 1C 00 04         [ 2]  419     addw    x, #4               ; GAP[0]
      00027E 4B 01            [ 1]  420     push    #1                  ; resume at low1
      000280 CC 03 32         [ 2]  421     jp      fall_common
      000283                        422 fall1:
      000283 90 93            [ 1]  423     ldw     y, x
      000285 72 A2 00 04      [ 2]  424     subw    y, #4               ; GAPW[0]
      000289 90 CF 00 08      [ 2]  425     ldw     _scan_fa, y
      00028D CF 00 0A         [ 2]  426     ldw     _scan_fb, x
      000290 35 00 00 0C      [ 1]  427     mov     _scan_sfa, #0
      000294 1C 00 05         [ 2]  428     addw    x, #5               ; GAP[1]
      000297 4B 02            [ 1]  429     push    #2
      000299 CC 03 32         [ 2]  430     jp      fall_common
      00029C                        431 fall2:
      00029C 90 93            [ 1]  432     ldw     y, x
      00029E 72 A2 00 04      [ 2]  433     subw    y, #4               ; GAPW[1]
      0002A2 90 CF 00 08      [ 2]  434     ldw     _scan_fa, y
      0002A6 CF 00 0A         [ 2]  435     ldw     _scan_fb, x
      0002A9 35 01 00 0C      [ 1]  436     mov     _scan_sfa, #1
      0002AD 1C 00 04         [ 2]  437     addw    x, #4               ; GAP[2]
      0002B0 4B 03            [ 1]  438     push    #3
      0002B2 CC 03 32         [ 2]  439     jp      fall_common
      0002B5                        440 fall3:
      0002B5 90 93            [ 1]  441     ldw     y, x
      0002B7 72 A2 00 04      [ 2]  442     subw    y, #4               ; GAPW[2]
      0002BB 90 CF 00 08      [ 2]  443     ldw     _scan_fa, y
      0002BF CF 00 0A         [ 2]  444     ldw     _scan_fb, x
      0002C2 35 02 00 0C      [ 1]  445     mov     _scan_sfa, #2
      0002C6 1C 00 04         [ 2]  446     addw    x, #4               ; GAP[3]
      0002C9 4B 04            [ 1]  447     push    #4
      0002CB CC 03 32         [ 2]  448     jp      fall_common
      0002CE                        449 fall4:
      0002CE 90 93            [ 1]  450     ldw     y, x
      0002D0 72 A2 00 06      [ 2]  451     subw    y, #6               ; GAPW[3]
      0002D4 90 CF 00 08      [ 2]  452     ldw     _scan_fa, y
      0002D8 CF 00 0A         [ 2]  453     ldw     _scan_fb, x
      0002DB 35 03 00 0C      [ 1]  454     mov     _scan_sfa, #3
      0002DF 1C 00 04         [ 2]  455     addw    x, #4               ; GAP[4]
      0002E2 4B 05            [ 1]  456     push    #5
      0002E4 CC 03 32         [ 2]  457     jp      fall_common
      0002E7                        458 fall5:
      0002E7 90 93            [ 1]  459     ldw     y, x
      0002E9 72 A2 00 04      [ 2]  460     subw    y, #4               ; GAPW[4]
      0002ED 90 CF 00 08      [ 2]  461     ldw     _scan_fa, y
      0002F1 CF 00 0A         [ 2]  462     ldw     _scan_fb, x
      0002F4 35 04 00 0C      [ 1]  463     mov     _scan_sfa, #4
      0002F8 1C 00 06         [ 2]  464     addw    x, #6               ; GAP[5]
      0002FB 4B 06            [ 1]  465     push    #6
      0002FD CC 03 32         [ 2]  466     jp      fall_common
      000300                        467 fall6:
      000300 90 93            [ 1]  468     ldw     y, x
      000302 72 A2 00 06      [ 2]  469     subw    y, #6               ; GAPW[5]
      000306 90 CF 00 08      [ 2]  470     ldw     _scan_fa, y
      00030A CF 00 0A         [ 2]  471     ldw     _scan_fb, x
      00030D 35 05 00 0C      [ 1]  472     mov     _scan_sfa, #5
      000311 1C 00 05         [ 2]  473     addw    x, #5               ; GAP[6]
      000314 4B 07            [ 1]  474     push    #7
      000316 CC 03 32         [ 2]  475     jp      fall_common
      000319                        476 fall7:
      000319 90 93            [ 1]  477     ldw     y, x
      00031B 72 A2 00 05      [ 2]  478     subw    y, #5               ; GAPW[6]
      00031F 90 CF 00 08      [ 2]  479     ldw     _scan_fa, y
      000323 CF 00 0A         [ 2]  480     ldw     _scan_fb, x
      000326 35 06 00 0C      [ 1]  481     mov     _scan_sfa, #6
      00032A 1C 00 08         [ 2]  482     addw    x, #8               ; GAP[7]
      00032D 4B 00            [ 1]  483     push    #0                  ; slot 7 resumes at the next octet fetch
      00032F CC 03 32         [ 2]  484     jp      fall_common
                                    485 
      000332                        486 fall_common:                    ; stack: resume index; A = octet, X = t
      000332 C7 00 13         [ 1]  487     ld      s_oct, a
      000335 CF 00 11         [ 2]  488     ldw     s_t, x
      000338 35 C7 00 15      [ 1]  489     mov     s_latch, #199       ; the fall sample itself counts (low_run=1)
      00033C 84               [ 1]  490     pop     a
      00033D C7 00 14         [ 1]  491     ld      s_res, a
      000340 A6 01            [ 1]  492     ld      a, #1
      000342 81               [ 4]  493     ret
                                    494 
                                    495 ; ------------------------------------------------------- 6-bit tail octet
                                    496 ; loop len-1 has no following byte: only R0..R5 exist (harness linearize
                                    497 ; drops BS0/BS1 of the last loop).  In practice the latch fires ~100
                                    498 ; loops earlier; this path exists for bit-exactness on arbitrary input.
      000343                        499 tail_low:
      000343 90 CE 00 0D      [ 2]  500     ldw     y, s_ptr
      000347 90 F6            [ 1]  501     ld      a, (y)
      000349 48               [ 1]  502     sll     a
      00034A 48               [ 1]  503     sll     a
      00034B 35 01 00 16      [ 1]  504     mov     s_tail, #1
      00034F CC 00 9D         [ 2]  505     jp      low0
                                    506 
      000352                        507 tail_high:
      000352 90 CE 00 0D      [ 2]  508     ldw     y, s_ptr
      000356 90 F6            [ 1]  509     ld      a, (y)
      000358 48               [ 1]  510     sll     a
      000359 48               [ 1]  511     sll     a
      00035A 35 01 00 16      [ 1]  512     mov     s_tail, #1
      00035E CC 02 16         [ 2]  513     jp      hi0
                                    514 
      000361                        515 end_low_tail:                   ; data exhausted, no pulse pending
      000361 35 08 00 14      [ 1]  516     mov     s_res, #8
      000365 4F               [ 1]  517     clr     a
      000366 81               [ 4]  518     ret
                                    519 
      000367                        520 end_high_tail:                  ; data exhausted mid-pulse: final pulse,
      000367 90 93            [ 1]  521     ldw     y, x                ; fb = fa + FIRST_BR (4)
      000369 72 A2 00 06      [ 2]  522     subw    y, #6               ; GAPW[5]: X is past tail slot 5
      00036D 90 CF 00 08      [ 2]  523     ldw     _scan_fa, y
      000371 72 A9 00 04      [ 2]  524     addw    y, #4
      000375 90 CF 00 0A      [ 2]  525     ldw     _scan_fb, y
      000379 35 05 00 0C      [ 1]  526     mov     _scan_sfa, #5
      00037D 35 08 00 14      [ 1]  527     mov     s_res, #8
      000381 A6 01            [ 1]  528     ld      a, #1
      000383 81               [ 4]  529     ret
                                    530 
                                    531 ; ======================================================================
                                    532 ; _cap_capture -- 256-loop WS2812 oversampling capture.
                                    533 ; Instruction-for-instruction identical to cap_code.s (the fitted sampler
                                    534 ; model is calibrated to THIS exact loop; any edit invalidates W_CY[] --
                                    535 ; EMBEDDED_V2_SPEC.md SS14 risk 7) except the loop count: 256 loops ->
                                    536 ; 256 bytes = 2048 samples = 592 us nominal, sized for the 216-bit v2.1
                                    537 ; test frame (117.7 loops at +8% incl. slack, spec SS3) plus the 200-low
                                    538 ; latch tail (25 loops) with >5x margin.
                                    539 ;
                                    540 ; ALIGNMENT IS PART OF THE FITTED MODEL (measured on this bench,
                                    541 ; 2026-09-06): the loop's real timing includes flash-fetch stalls that
                                    542 ; depend on the code's address phase.  capture.ihx (the image the
                                    543 ; 40-cycle model was fitted against) has _cap_code at 0x8111; linking
                                    544 ; this routine as ordinary relocatable CODE landed it at 0x9E1E (phase 0
                                    545 ; mod 4 instead of 1) and every bench decode then measured eps at
                                    546 ; +6.2..+7.5% instead of this unit's -1.07% -- i.e. at that phase the
                                    547 ; loop really runs ~37 cycles, the DOCUMENTED count, with no stalls.
                                    548 ; 0.9893 * 40/37 - 1 = +6.95%: the observed shift, exactly.  So the
                                    549 ; routine lives in an ABS area at 0x9FA1 = 0x8111 (mod 16), restoring
                                    550 ; the fitted stall pattern.  The Makefile guards against CODE growing
                                    551 ; into it (sdld does not check REL/ABS overlaps).
                                    552 ; Entry: X = capture buffer pointer.  Clobbers: A, X, Y, C.
                                    553 ; ======================================================================
                                    554     .area CAPLOOP (ABS)
      009FA1                        555     .org 0x9FA1
      009FA1                        556 _cap_capture:
      009FA1 90 AE 01 00      [ 2]  557     ldw     y, #256
                                    558 
      009FA5                        559 00010$:                             ; wait_low
      009FA5 72 06 50 0B FB   [ 2]  560     btjt    0x500B, #3, 00010$
      009FAA                        561 00011$:                             ; wait_high
      009FAA 72 07 50 0B FB   [ 2]  562     btjf    0x500B, #3, 00011$
                                    563 
      009FAF                        564 _cap_loop:                          ; sampling loop, address-phase pinned:
      009FAF                        565 00012$:                             ; MUST stay == 0x811F (mod 16); label
                                    566                                     ; adds no bytes -- cap_byte
      009FAF 49               [ 1]  567     rlc     a                       ; deposit BS1 from C (prev boundary)
                                    568 
      009FB0 72 06 50 0B 01   [ 2]  569     btjt    0x500B, #3, 00013$      ; R0
      009FB5 9D               [ 1]  570     nop
      009FB6 49               [ 1]  571 00013$: rlc     a
                                    572 
      009FB7 72 06 50 0B 01   [ 2]  573     btjt    0x500B, #3, 00014$      ; R1
      009FBC 9D               [ 1]  574     nop
      009FBD 49               [ 1]  575 00014$: rlc     a
                                    576 
      009FBE 72 06 50 0B 01   [ 2]  577     btjt    0x500B, #3, 00015$      ; R2
      009FC3 9D               [ 1]  578     nop
      009FC4 49               [ 1]  579 00015$: rlc     a
                                    580 
      009FC5 72 06 50 0B 01   [ 2]  581     btjt    0x500B, #3, 00016$      ; R3
      009FCA 9D               [ 1]  582     nop
      009FCB 49               [ 1]  583 00016$: rlc     a
                                    584 
      009FCC 72 06 50 0B 01   [ 2]  585     btjt    0x500B, #3, 00017$      ; R4
      009FD1 9D               [ 1]  586     nop
      009FD2 49               [ 1]  587 00017$: rlc     a
                                    588 
      009FD3 72 06 50 0B 01   [ 2]  589     btjt    0x500B, #3, 00018$      ; R5
      009FD8 9D               [ 1]  590     nop
      009FD9 49               [ 1]  591 00018$: rlc     a
                                    592 
      009FDA F7               [ 1]  593     ld      (x), a                  ; store byte
      009FDB 5C               [ 1]  594     incw    x
                                    595 
      009FDC 72 06 50 0B 01   [ 2]  596     btjt    0x500B, #3, 00019$      ; BS0
      009FE1 9D               [ 1]  597     nop
      009FE2 49               [ 1]  598 00019$: rlc     a
                                    599 
      009FE3 90 5A            [ 2]  600     decw    y                       ; loop counter (sets Z)
                                    601 
      009FE5 72 06 50 0B 01   [ 2]  602     btjt    0x500B, #3, 00020$      ; BS1 -- C only, Z preserved
      009FEA 9D               [ 1]  603     nop
      009FEB                        604 00020$:
                                    605 
      009FEB 26 C2            [ 1]  606     jrne    00012$                  ; loop (tests Z from decw)
                                    607 
      009FED 9A               [ 1]  608     rim                             ; post-loop: timing-irrelevant.  For a
      009FEE A6 01            [ 1]  609     ld      a, #1                   ; _cap_arm entry this re-enables the
      009FF0 81               [ 4]  610     ret                             ; tick and flags "captured" (A=1);
                                    611                                     ; harmless for the legacy bench entry
                                    612                                     ; (no interrupt sources enabled there)
