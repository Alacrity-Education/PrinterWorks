                                   1849 ; ======================================================================
                                   1850 ; CRC8 confidence chase (spec SS7) + ws_decode_ex -- the pipeline tail.
                                   1851 ; Bit-exact port of decode.c's C versions (which remain the host-parity
                                   1852 ; reference under !USE_ASM_DEC).
                                   1853 ; ======================================================================
                                   1854 
                                   1855     .globl _ws_decode_ex
                                   1856     .globl _g_ND
