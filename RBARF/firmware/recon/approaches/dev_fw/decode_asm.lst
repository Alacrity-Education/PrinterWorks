                                   1355 ; ---------------------------------------------------------------- decide
                                   1356 ; g_sg -> d_costs[0..acap], dq_inter, dq_acap/afree/lo/hi/ahat.
      0006C1                       1357 dq_decide:
      0006C1 BE 5F            [ 2] 1358     ldw     x, *_g_sg+2
      0006C3 72 B0 00 5D      [ 2] 1359     subw    x, _g_sg
      0006C7 BF 7C            [ 2] 1360     ldw     *m_L, x                 ; L = k1-k0 (>= 1)
      0006C9 A3 00 10         [ 2] 1361     cpw     x, #16
      0006CC 25 03            [ 1] 1362     jrc     00170$
      0006CE AE 00 0F         [ 2] 1363     ldw     x, #15
      0006D1                       1364 00170$:
      0006D1 BF 6C            [ 2] 1365     ldw     *dq_acap, x
      0006D3 BE DF            [ 2] 1366     ldw     x, *zh0c
      0006D5 BF 76            [ 2] 1367     ldw     *m_h0, x
      0006D7 BE E1            [ 2] 1368     ldw     x, *zh1c
      0006D9 BF 78            [ 2] 1369     ldw     *m_h1, x
      0006DB B6 65            [ 1] 1370     ld      a, *_g_sg+8             ; fam
      0006DD A1 05            [ 1] 1371     cp      a, #5
      0006DF 26 07            [ 1] 1372     jrne    00171$
      0006E1 B6 E3            [ 1] 1373     ld      a, *zd56
      0006E3 CD 06 A6         [ 4] 1374     call    addd56
      0006E6 20 09            [ 2] 1375     jra     00172$
      0006E8                       1376 00171$:
      0006E8 A1 06            [ 1] 1377     cp      a, #6
      0006EA 26 05            [ 1] 1378     jrne    00172$
      0006EC B6 E4            [ 1] 1379     ld      a, *zd56+1
      0006EE CD 06 A6         [ 4] 1380     call    addd56
      0006F1                       1381 00172$:
      0006F1 5F               [ 1] 1382     clrw    x
      0006F2 BF 6A            [ 2] 1383     ldw     *dq_inter, x
      0006F4 3F 91            [ 1] 1384     clr     *m_ai
      0006F6                       1385 00173$:                         ; per hypothesis a
      0006F6 B6 91            [ 1] 1386     ld      a, *m_ai
      0006F8 26 0E            [ 1] 1387     jrne    00174$
      0006FA BE 76            [ 2] 1388     ldw     x, *m_h0                ; a == 0
      0006FC CD 05 EA         [ 4] 1389     call    hcost
      0006FF BF 7E            [ 2] 1390     ldw     *m_c, x
      000701 CD 06 0B         [ 4] 1391     call    itst
      000704 B7 90            [ 1] 1392     ld      *m_it, a
      000706 20 38            [ 2] 1393     jra     00177$
      000708                       1394 00174$:
      000708 4A               [ 1] 1395     dec     a                       ; a >= 1: h = (a-1)*512 + h1e
      000709 48               [ 1] 1396     sll     a
      00070A 5F               [ 1] 1397     clrw    x
      00070B 95               [ 1] 1398     ld      xh, a
      00070C 72 BB 00 78      [ 2] 1399     addw    x, m_h1
      000710 CD 05 EA         [ 4] 1400     call    hcost
      000713 BF 7E            [ 2] 1401     ldw     *m_c, x
      000715 CD 06 0B         [ 4] 1402     call    itst
      000718 B7 90            [ 1] 1403     ld      *m_it, a
      00071A B6 91            [ 1] 1404     ld      a, *m_ai                ; if a < L: h2 = a*512 + h0e
      00071C 5F               [ 1] 1405     clrw    x
      00071D 97               [ 1] 1406     ld      xl, a
      00071E B3 7C            [ 2] 1407     cpw     x, *m_L
      000720 24 1E            [ 1] 1408     jrnc    00177$
      000722 B6 91            [ 1] 1409     ld      a, *m_ai
      000724 48               [ 1] 1410     sll     a
      000725 5F               [ 1] 1411     clrw    x
      000726 95               [ 1] 1412     ld      xh, a
      000727 72 BB 00 76      [ 2] 1413     addw    x, m_h0
      00072B CD 05 EA         [ 4] 1414     call    hcost
      00072E 89               [ 2] 1415     pushw   x
      00072F CD 06 0B         [ 4] 1416     call    itst
      000732 4D               [ 1] 1417     tnz     a
      000733 27 04            [ 1] 1418     jreq    00175$
      000735 35 01 00 90      [ 1] 1419     mov     m_it, #1
      000739                       1420 00175$:
      000739 85               [ 2] 1421     popw    x
      00073A B3 7E            [ 2] 1422     cpw     x, *m_c
      00073C 24 02            [ 1] 1423     jrnc    00177$
      00073E BF 7E            [ 2] 1424     ldw     *m_c, x
      000740                       1425 00177$:                         ; store costs[a] + interior bit
      000740 B6 91            [ 1] 1426     ld      a, *m_ai
      000742 48               [ 1] 1427     sll     a
      000743 5F               [ 1] 1428     clrw    x
      000744 97               [ 1] 1429     ld      xl, a
      000745 90 BE 7E         [ 2] 1430     ldw     y, *m_c
      000748 DF 00 00         [ 2] 1431     ldw     (d_costs, x), y
      00074B 3D 90            [ 1] 1432     tnz     *m_it
      00074D 27 03            [ 1] 1433     jreq    00178$
      00074F CD 06 1E         [ 4] 1434     call    setbit
      000752                       1435 00178$:
      000752 B6 91            [ 1] 1436     ld      a, *m_ai
      000754 4C               [ 1] 1437     inc     a
      000755 B7 91            [ 1] 1438     ld      *m_ai, a
      000757 B1 6D            [ 1] 1439     cp      a, *dq_acap+1
      000759 23 9B            [ 2] 1440     jrule   00173$
                                   1441     ; a_free = argmin(0, acap)
      00075B 3F 93            [ 1] 1442     clr     *m_alo
      00075D B6 6D            [ 1] 1443     ld      a, *dq_acap+1
      00075F B7 94            [ 1] 1444     ld      *m_ahi, a
      000761 CD 06 5C         [ 4] 1445     call    argmin
      000764 BF 74            [ 2] 1446     ldw     *dq_afree, x
      000766 CD 05 9C         [ 4] 1447     call    _a_bounds_sg
      000769 BE 66            [ 2] 1448     ldw     x, *_dq_amin            ; lo = amin (>= 0)
      00076B BF 6E            [ 2] 1449     ldw     *dq_lo, x
      00076D BE 68            [ 2] 1450     ldw     x, *_dq_amax            ; hi = min(amax, acap)
      00076F B3 6C            [ 2] 1451     cpw     x, *dq_acap
      000771 25 02            [ 1] 1452     jrc     00179$
      000773 BE 6C            [ 2] 1453     ldw     x, *dq_acap
      000775                       1454 00179$:
      000775 BF 70            [ 2] 1455     ldw     *dq_hi, x
      000777 BE 6E            [ 2] 1456     ldw     x, *dq_lo
      000779 B3 70            [ 2] 1457     cpw     x, *dq_hi
      00077B 23 07            [ 2] 1458     jrule   00180$
      00077D 5F               [ 1] 1459     clrw    x                   ; lo > hi: full range
      00077E BF 6E            [ 2] 1460     ldw     *dq_lo, x
      000780 BE 6C            [ 2] 1461     ldw     x, *dq_acap
      000782 BF 70            [ 2] 1462     ldw     *dq_hi, x
      000784                       1463 00180$:
      000784 B6 6F            [ 1] 1464     ld      a, *dq_lo+1
      000786 B7 93            [ 1] 1465     ld      *m_alo, a
      000788 B6 71            [ 1] 1466     ld      a, *dq_hi+1
      00078A B7 94            [ 1] 1467     ld      *m_ahi, a
      00078C CD 06 5C         [ 4] 1468     call    argmin
      00078F BF 72            [ 2] 1469     ldw     *dq_ahat, x
      000791 81               [ 4] 1470     ret
                                   1471 
                                   1472 ; ------------------------------------------------------------ cand_insert
                                   1473 ; X = payload' bit index k, A = margin m: sorted top-5 insert
                                   1474 ; (key: margin then index, ascending) -- exactly C cand_insert.
      000792                       1475 candi:
      000792 B7 9C            [ 1] 1476     ld      *m_m, a
      000794 BF 8A            [ 2] 1477     ldw     *m_k, x
      000796 B6 A3            [ 1] 1478     ld      a, *zc_n
      000798 B7 9A            [ 1] 1479     ld      *m_i, a
      00079A                       1480 00185$:                         ; while (i > 0 && cand_m[i-1] > m) i--
      00079A 3D 9A            [ 1] 1481     tnz     *m_i
      00079C 27 10            [ 1] 1482     jreq    00186$
      00079E B6 9A            [ 1] 1483     ld      a, *m_i
      0007A0 4A               [ 1] 1484     dec     a
      0007A1 5F               [ 1] 1485     clrw    x
      0007A2 97               [ 1] 1486     ld      xl, a
      0007A3 D6 00 4A         [ 1] 1487     ld      a, (zc_m, x)
      0007A6 B1 9C            [ 1] 1488     cp      a, *m_m
      0007A8 23 04            [ 2] 1489     jrule   00186$
      0007AA 3A 9A            [ 1] 1490     dec     *m_i
