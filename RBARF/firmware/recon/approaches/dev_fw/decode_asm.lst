                                   1102 ; ======================================================================
                                   1103 ; P4 decision cluster: known_bit / a_bounds / hinge / argmin / decide /
                                   1104 ; cand_insert / decide_pass.  Replaces ~1470 B of SDCC output.
                                   1105 ; The per-bit margin scan uses an exactly-equivalent prefix-min (online)
                                   1106 ; + suffix-min (precomputed d_sm[]) formulation of the C's inner loops:
                                   1107 ;   c0m(off) = min costs[a in lo..min(off,hi)]   (empty -> 0xFFFF)
                                   1108 ;   c1m(off) = min costs[a in max(lo,off+1)..hi] (empty -> 0xFFFF)
                                   1109 ; identical values, O(L+W) instead of O(L*W).
                                   1110 ; ======================================================================
                                   1111 
                                   1112     .globl _decide_pass
                                   1113     .globl _known_bit
                                   1114     .globl _a_bounds_sg
                                   1115     .globl _g_sg
                                   1116     .globl _dq_amin
                                   1117     .globl _dq_amax
                                   1118     .globl _g_NBm32
                                   1119     .globl _g_PPHI
                                   1120 
                                   1121     .globl _ov
                                   1122 
                                   1123     .area CODE
                                   1124 
                                   1125 ; -------------------------------------------------------------- known_bit
                                   1126 ; X = t -> A = 0 / 1 / 0xFF(-1).  C-ABI compatible (calibrate and
                                   1127 ; ws_decode_ex call this directly).
      00056F                       1128 _known_bit:
      00056F A3 00 20         [ 2] 1129     cpw     x, #32
      000572 25 09            [ 1] 1130     jrc     00130$              ; header bits 0..31
      000574 72 B0 00 00      [ 2] 1131     subw    x, _g_NBm32
      000578 25 17            [ 1] 1132     jrc     00132$              ; interior
      00057A 1C 00 20         [ 2] 1133     addw    x, #32              ; trailer bits at HT[32..63]
      00057D                       1134 00130$:
      00057D 9F               [ 1] 1135     ld      a, xl
      00057E A4 07            [ 1] 1136     and     a, #7
      000580 4C               [ 1] 1137     inc     a
      000581 B7 0D            [ 1] 1138     ld      *m_s, a                 ; shift count = (t&7)+1
      000583 54               [ 2] 1139     srlw    x
      000584 54               [ 2] 1140     srlw    x
      000585 54               [ 2] 1141     srlw    x
      000586 D6 05 94         [ 1] 1142     ld      a, (HT, x)
      000589                       1143 00131$:
      000589 48               [ 1] 1144     sll     a
      00058A 3A 0D            [ 1] 1145     dec     *m_s
      00058C 26 FB            [ 1] 1146     jrne    00131$
      00058E 4F               [ 1] 1147     clr     a
      00058F 49               [ 1] 1148     rlc     a                       ; A = the bit
      000590 81               [ 4] 1149     ret
      000591                       1150 00132$:
      000591 A6 FF            [ 1] 1151     ld      a, #0xFF
      000593 81               [ 4] 1152     ret
      000594 FF 00 AA 65 9A 55 00  1153 HT: .db 0xFF,0x00,0xAA,0x65,0x9A,0x55,0x00,0xFF
             FF
                                   1154 
                                   1155 ; ------------------------------------------------------------ a_bounds_sg
                                   1156 ; a_bounds over g_sg -> dq_amin/dq_amax (C calibrate uses this too).
      00059C                       1157 _a_bounds_sg:
      00059C 5F               [ 1] 1158     clrw    x
      00059D BF 66            [ 2] 1159     ldw     *_dq_amin, x
      00059F BE 5F            [ 2] 1160     ldw     x, *_g_sg+2
      0005A1 72 B0 00 5D      [ 2] 1161     subw    x, _g_sg
      0005A5 BF 68            [ 2] 1162     ldw     *_dq_amax, x
      0005A7 BE 5F            [ 2] 1163     ldw     x, *_g_sg+2             ; e = min(k1, NB)
      0005A9 C3 00 00         [ 2] 1164     cpw     x, _g_NB
      0005AC 25 03            [ 1] 1165     jrc     00140$
      0005AE CE 00 00         [ 2] 1166     ldw     x, _g_NB
      0005B1                       1167 00140$:
      0005B1 BF 84            [ 2] 1168     ldw     *m_e, x
      0005B3 BE 5D            [ 2] 1169     ldw     x, *_g_sg
      0005B5 BF 86            [ 2] 1170     ldw     *m_t, x
      0005B7                       1171 00141$:
      0005B7 BE 86            [ 2] 1172     ldw     x, *m_t
      0005B9 B3 84            [ 2] 1173     cpw     x, *m_e
      0005BB 24 2C            [ 1] 1174     jrnc    00149$
      0005BD CD 05 6F         [ 4] 1175     call    _known_bit
      0005C0 A1 01            [ 1] 1176     cp      a, #1
      0005C2 26 0F            [ 1] 1177     jrne    00142$
      0005C4 BE 86            [ 2] 1178     ldw     x, *m_t                 ; kb == 1: amin = max(amin, t-k0+1)
      0005C6 72 B0 00 5D      [ 2] 1179     subw    x, _g_sg
      0005CA 5C               [ 1] 1180     incw    x
      0005CB B3 66            [ 2] 1181     cpw     x, *_dq_amin
      0005CD 23 13            [ 2] 1182     jrule   00144$
      0005CF BF 66            [ 2] 1183     ldw     *_dq_amin, x
      0005D1 20 0F            [ 2] 1184     jra     00144$
      0005D3                       1185 00142$:
      0005D3 4D               [ 1] 1186     tnz     a
      0005D4 26 0C            [ 1] 1187     jrne    00144$              ; -1: nothing
      0005D6 BE 86            [ 2] 1188     ldw     x, *m_t                 ; kb == 0: amax = min(amax, t-k0)
      0005D8 72 B0 00 5D      [ 2] 1189     subw    x, _g_sg
      0005DC B3 68            [ 2] 1190     cpw     x, *_dq_amax
      0005DE 24 02            [ 1] 1191     jrnc    00144$
      0005E0 BF 68            [ 2] 1192     ldw     *_dq_amax, x
      0005E2                       1193 00144$:
      0005E2 BE 86            [ 2] 1194     ldw     x, *m_t
      0005E4 5C               [ 1] 1195     incw    x
      0005E5 BF 86            [ 2] 1196     ldw     *m_t, x
      0005E7 20 CE            [ 2] 1197     jra     00141$
      0005E9                       1198 00149$:
      0005E9 81               [ 4] 1199     ret
                                   1200 
                                   1201 ; ---------------------------------------------------------------- hcost
                                   1202 ; X = h -> X = hinge(u, v, h) = max(0, u-h, h-v); g_sg.u/.v.  Keeps m_h.
      0005EA                       1203 hcost:
      0005EA BF 7A            [ 2] 1204     ldw     *m_h, x
      0005EC BE 61            [ 2] 1205     ldw     x, *_g_sg+4
      0005EE 72 B0 00 7A      [ 2] 1206     subw    x, m_h              ; u - h (s16)
      0005F2 2C 01            [ 1] 1207     jrsgt   00150$
      0005F4 5F               [ 1] 1208     clrw    x
      0005F5                       1209 00150$:
      0005F5 90 93            [ 1] 1210     ldw     y, x                    ; Y = g so far
      0005F7 BE 7A            [ 2] 1211     ldw     x, *m_h
      0005F9 72 B0 00 63      [ 2] 1212     subw    x, _g_sg+6          ; h - v (s16)
      0005FD 2C 02            [ 1] 1213     jrsgt   00151$
      0005FF 93               [ 1] 1214     ldw     x, y
      000600 81               [ 4] 1215     ret
      000601                       1216 00151$:
      000601 90 89            [ 2] 1217     pushw   y                   ; g
      000603 13 01            [ 2] 1218     cpw     x, (1, sp)
      000605 90 85            [ 2] 1219     popw    y
      000607 22 01            [ 1] 1220     jrugt   00152$
      000609 93               [ 1] 1221     ldw     x, y
      00060A                       1222 00152$:
      00060A 81               [ 4] 1223     ret
                                   1224 
                                   1225 ; ----------------------------------------------------------------- itst
                                   1226 ; A = (u < m_h && m_h <= v), signed.
      00060B                       1227 itst:
      00060B BE 61            [ 2] 1228     ldw     x, *_g_sg+4
      00060D B3 7A            [ 2] 1229     cpw     x, *m_h
      00060F 2F 02            [ 1] 1230     jrslt   00153$
      000611 4F               [ 1] 1231     clr     a
      000612 81               [ 4] 1232     ret
      000613                       1233 00153$:
      000613 BE 7A            [ 2] 1234     ldw     x, *m_h
      000615 B3 63            [ 2] 1235     cpw     x, *_g_sg+6
      000617 2D 02            [ 1] 1236     jrsle   00154$
      000619 4F               [ 1] 1237     clr     a
      00061A 81               [ 4] 1238     ret
      00061B                       1239 00154$:
      00061B A6 01            [ 1] 1240     ld      a, #1
      00061D 81               [ 4] 1241     ret
                                   1242 
                                   1243 ; --------------------------------------------------------------- setbit
                                   1244 ; dq_inter |= 1 << m_ai
      00061E                       1245 setbit:
      00061E B6 91            [ 1] 1246     ld      a, *m_ai
      000620 A4 07            [ 1] 1247     and     a, #7
      000622 B7 0D            [ 1] 1248     ld      *m_s, a
      000624 A6 01            [ 1] 1249     ld      a, #1
      000626 3D 0D            [ 1] 1250     tnz     *m_s
      000628 27 05            [ 1] 1251     jreq    00156$
      00062A                       1252 00155$:
      00062A 48               [ 1] 1253     sll     a
      00062B 3A 0D            [ 1] 1254     dec     *m_s
      00062D 26 FB            [ 1] 1255     jrne    00155$
      00062F                       1256 00156$:
      00062F 88               [ 1] 1257     push    a
      000630 B6 91            [ 1] 1258     ld      a, *m_ai
      000632 A1 08            [ 1] 1259     cp      a, #8
      000634 84               [ 1] 1260     pop     a
      000635 25 05            [ 1] 1261     jrc     00157$
      000637 BA 6A            [ 1] 1262     or      a, *dq_inter            ; bits 8..15 live in the high byte
      000639 B7 6A            [ 1] 1263     ld      *dq_inter, a
      00063B 81               [ 4] 1264     ret
      00063C                       1265 00157$:
      00063C BA 6B            [ 1] 1266     or      a, *dq_inter+1
      00063E B7 6B            [ 1] 1267     ld      *dq_inter+1, a
      000640 81               [ 4] 1268     ret
                                   1269 
                                   1270 ; --------------------------------------------------------------- getbit
                                   1271 ; A = (dq_inter >> m_ai2) & 1
      000641                       1272 getbit:
      000641 B6 92            [ 1] 1273     ld      a, *m_ai2
      000643 A4 07            [ 1] 1274     and     a, #7
      000645 4C               [ 1] 1275     inc     a
      000646 B7 0D            [ 1] 1276     ld      *m_s, a
      000648 B6 92            [ 1] 1277     ld      a, *m_ai2
      00064A A1 08            [ 1] 1278     cp      a, #8
      00064C 25 04            [ 1] 1279     jrc     00158$
      00064E B6 6A            [ 1] 1280     ld      a, *dq_inter
      000650 20 02            [ 2] 1281     jra     00159$
      000652                       1282 00158$:
      000652 B6 6B            [ 1] 1283     ld      a, *dq_inter+1
      000654                       1284 00159$:
      000654 44               [ 1] 1285     srl     a
      000655 3A 0D            [ 1] 1286     dec     *m_s
      000657 26 FB            [ 1] 1287     jrne    00159$
      000659 4F               [ 1] 1288     clr     a
      00065A 49               [ 1] 1289     rlc     a
      00065B 81               [ 4] 1290     ret
                                   1291 
                                   1292 ; --------------------------------------------------------------- argmin
                                   1293 ; over [m_alo..m_ahi]: (cost, interior-preferred-on-tie, smallest a).
                                   1294 ; -> X = best.  Mirrors C argmin_ab exactly (bc=0xFFFF, bi=1 initial).
      00065C                       1295 argmin:
      00065C AE FF FF         [ 2] 1296     ldw     x, #0xFFFF
      00065F BF 7E            [ 2] 1297     ldw     *m_c, x
      000661 35 01 00 90      [ 1] 1298     mov     m_it, #1
      000665 B6 93            [ 1] 1299     ld      a, *m_alo
      000667 B7 95            [ 1] 1300     ld      *m_best, a
      000669 B7 92            [ 1] 1301     ld      *m_ai2, a
      00066B                       1302 00160$:
      00066B B6 92            [ 1] 1303     ld      a, *m_ai2
      00066D 48               [ 1] 1304     sll     a
      00066E 5F               [ 1] 1305     clrw    x
      00066F 97               [ 1] 1306     ld      xl, a
      000670 DE 00 00         [ 2] 1307     ldw     x, (d_costs, x)
      000673 B3 7E            [ 2] 1308     cpw     x, *m_c
      000675 25 16            [ 1] 1309     jrc     00161$              ; strictly better
      000677 26 1F            [ 1] 1310     jrne    00163$              ; worse
      000679 CD 06 41         [ 4] 1311     call    getbit              ; equal: take iff it && !bi
      00067C 4D               [ 1] 1312     tnz     a
      00067D 27 19            [ 1] 1313     jreq    00163$
      00067F 3D 90            [ 1] 1314     tnz     *m_it
      000681 26 15            [ 1] 1315     jrne    00163$
      000683 35 01 00 90      [ 1] 1316     mov     m_it, #1
      000687 B6 92            [ 1] 1317     ld      a, *m_ai2
      000689 B7 95            [ 1] 1318     ld      *m_best, a
      00068B 20 0B            [ 2] 1319     jra     00163$
      00068D                       1320 00161$:
      00068D BF 7E            [ 2] 1321     ldw     *m_c, x
      00068F CD 06 41         [ 4] 1322     call    getbit
      000692 B7 90            [ 1] 1323     ld      *m_it, a
      000694 B6 92            [ 1] 1324     ld      a, *m_ai2
      000696 B7 95            [ 1] 1325     ld      *m_best, a
      000698                       1326 00163$:
      000698 B6 92            [ 1] 1327     ld      a, *m_ai2
      00069A 4C               [ 1] 1328     inc     a
      00069B B7 92            [ 1] 1329     ld      *m_ai2, a
      00069D B1 94            [ 1] 1330     cp      a, *m_ahi
      00069F 23 CA            [ 2] 1331     jrule   00160$
      0006A1 5F               [ 1] 1332     clrw    x
      0006A2 B6 95            [ 1] 1333     ld      a, *m_best
      0006A4 97               [ 1] 1334     ld      xl, a
      0006A5 81               [ 4] 1335     ret
                                   1336 
                                   1337 ; --------------------------------------------------------------- addd56
                                   1338 ; m_h0 += sext(A); m_h1 += sext(A)
      0006A6                       1339 addd56:
      0006A6 5F               [ 1] 1340     clrw    x
      0006A7 97               [ 1] 1341     ld      xl, a
      0006A8 4D               [ 1] 1342     tnz     a
      0006A9 2A 03            [ 1] 1343     jrpl    00165$
      0006AB 1C FF 00         [ 2] 1344     addw    x, #0xFF00
      0006AE                       1345 00165$:
      0006AE BF 7A            [ 2] 1346     ldw     *m_h, x
      0006B0 BE 76            [ 2] 1347     ldw     x, *m_h0
      0006B2 72 BB 00 7A      [ 2] 1348     addw    x, m_h
      0006B6 BF 76            [ 2] 1349     ldw     *m_h0, x
      0006B8 BE 78            [ 2] 1350     ldw     x, *m_h1
      0006BA 72 BB 00 7A      [ 2] 1351     addw    x, m_h
      0006BE BF 78            [ 2] 1352     ldw     *m_h1, x
      0006C0 81               [ 4] 1353     ret
