                                    656     .area CODE
                                    657 
                                    658 ; ---------------------------------------------------------------- refine
      00025B                        659 _refine:
      00025B AE 00 14         [ 2]  660     ldw     x, #20                  ; zero r_lo + r_hi (adjacent)
      00025E                        661 00060$:
      00025E 72 4F 00 2F      [ 1]  662     clr     (r_lo-1, x)
      000262 5A               [ 2]  663     decw    x
      000263 26 F9            [ 1]  664     jrne    00060$
      000265 CD 13 57         [ 4]  665     call    _scan_init
      000268                        666 00061$:                         ; pulse loop
      000268 CD 13 73         [ 4]  667     call    _scan_next
      00026B 4D               [ 1]  668     tnz     a
      00026C 27 6A            [ 1]  669     jreq    00070$
      00026E CE 00 BB         [ 2]  670     ldw     x, _scan_ra
      000271 72 BB 00 BD      [ 2]  671     addw    x, _scan_rb
      000275 54               [ 2]  672     srlw    x
      000276 CD 00 34         [ 4]  673     call    mr16
      000279 3D 09            [ 1]  674     tnz     *m_y
      00027B 2A 05            [ 1]  675     jrpl    00062$
      00027D 5F               [ 1]  676     clrw    x                   ; clamp y >= 0
      00027E BF 09            [ 2]  677     ldw     *m_y, x
      000280 BF 0B            [ 2]  678     ldw     *m_y+2, x
      000282                        679 00062$:
      000282 C6 00 03         [ 1]  680     ld      a, _g_yend+3            ; if y > y_end: stop accumulating
      000285 B0 0C            [ 1]  681     sub     a, *m_y+3
      000287 C6 00 02         [ 1]  682     ld      a, _g_yend+2
      00028A B2 0B            [ 1]  683     sbc     a, *m_y+2
      00028C C6 00 01         [ 1]  684     ld      a, _g_yend+1
      00028F B2 0A            [ 1]  685     sbc     a, *m_y+1
      000291 C6 00 00         [ 1]  686     ld      a, _g_yend
      000294 B2 09            [ 1]  687     sbc     a, *m_y
      000296 25 40            [ 1]  688     jrc     00070$
                                    689     ; q = (y + 256) >> 9 ; e = low16(y) - low16(q << 9)
      000298 BE 0B            [ 2]  690     ldw     x, *m_y+2
      00029A B6 0A            [ 1]  691     ld      a, *m_y+1
      00029C 1C 01 00         [ 2]  692     addw    x, #0x0100
      00029F A9 00            [ 1]  693     adc     a, #0
      0002A1 5E               [ 1]  694     swapw   x
      0002A2 95               [ 1]  695     ld      xh, a
      0002A3 54               [ 2]  696     srlw    x                   ; X = q
      0002A4 9F               [ 1]  697     ld      a, xl
      0002A5 5F               [ 1]  698     clrw    x
      0002A6 95               [ 1]  699     ld      xh, a
      0002A7 58               [ 2]  700     sllw    x                   ; X = low16(q << 9)
      0002A8 BF 03            [ 2]  701     ldw     *m_b, x
      0002AA BE 0B            [ 2]  702     ldw     x, *m_y+2
      0002AC 72 B0 00 03      [ 2]  703     subw    x, m_b              ; X = e (s16 exact)
                                    704     ; block = (y < mid_u) ? r_lo : r_hi
      0002B0 B6 0C            [ 1]  705     ld      a, *m_y+3
      0002B2 C0 00 03         [ 1]  706     sub     a, _g_ymid+3
      0002B5 B6 0B            [ 1]  707     ld      a, *m_y+2
      0002B7 C2 00 02         [ 1]  708     sbc     a, _g_ymid+2
      0002BA B6 0A            [ 1]  709     ld      a, *m_y+1
      0002BC C2 00 01         [ 1]  710     sbc     a, _g_ymid+1
      0002BF B6 09            [ 1]  711     ld      a, *m_y
      0002C1 C2 00 00         [ 1]  712     sbc     a, _g_ymid
      0002C4 25 06            [ 1]  713     jrc     00063$
      0002C6 90 AE 00 3A      [ 2]  714     ldw     y, #r_hi
      0002CA 20 04            [ 2]  715     jra     00064$
      0002CC                        716 00063$:
      0002CC 90 AE 00 30      [ 2]  717     ldw     y, #r_lo
      0002D0                        718 00064$:
      0002D0 CD 02 03         [ 4]  719     call    accum
      0002D3 20 93            [ 2]  720     jra     00061$
                                    721 
      0002D5                        722 00069$:
      0002D5 CC 04 95         [ 2]  723     jp      00099$              ; short-branch trampoline to the ret
      0002D8                        724 00070$:                         ; stats
      0002D8 BE 38            [ 2]  725     ldw     x, *r_lo+8
      0002DA A3 00 02         [ 2]  726     cpw     x, #2
      0002DD 25 F6            [ 1]  727     jrc     00069$
      0002DF BE 42            [ 2]  728     ldw     x, *r_hi+8
      0002E1 A3 00 02         [ 2]  729     cpw     x, #2
      0002E4 25 EF            [ 1]  730     jrc     00069$
      0002E6 AE 00 30         [ 2]  731     ldw     x, #r_lo
      0002E9 CD 80 14         [ 4]  732     call    mediv
      0002EC BF 44            [ 2]  733     ldw     *r_melo, x
      0002EE AE 00 3A         [ 2]  734     ldw     x, #r_hi
      0002F1 CD 80 14         [ 4]  735     call    mediv
      0002F4 BF 46            [ 2]  736     ldw     *r_mehi, x
      0002F6 AE 00 30         [ 2]  737     ldw     x, #r_lo
      0002F9 CD 80 40         [ 4]  738     call    mydiv
      0002FC BE 24            [ 2]  739     ldw     x, *m_n
      0002FE BF 54            [ 2]  740     ldw     *r_mylo, x
      000300 BE 26            [ 2]  741     ldw     x, *m_n+2
      000302 BF 56            [ 2]  742     ldw     *r_mylo+2, x
      000304 AE 00 3A         [ 2]  743     ldw     x, #r_hi
      000307 CD 80 40         [ 4]  744     call    mydiv
      00030A BE 24            [ 2]  745     ldw     x, *m_n
      00030C BF 58            [ 2]  746     ldw     *r_myhi, x
