                                    478 ; ======================================================================
                                    479 ; refine() -- P2 residual-regression lock refinement, bit-exact port of
                                    480 ; decode.c's C version.  Uses mr16/mul16 above plus udiv32 below.
                                    481 ; Range notes (reference assert battery): e in [-256,255]; |me| <= 256 so
                                    482 ; de fits s16; sy sums < 2^27; my quotients < 2^20; K*de < 2^25;
                                    483 ; |de*(my-tau)| < 2^31 (asserted); dtau/tau commits are exact in low-16
                                    484 ; (C truncates to int16_t).
                                    485 ; ======================================================================
                                    486 
                                    487     .globl _refine
                                    488     .globl _g_ymid
                                    489 
                                    490     .area CODE
                                    491 
                                    492 ; ---------------------------------------------------------------- udiv32
                                    493 ; m_n / m_d -> quotient in m_n, remainder in m_r.  m_d preserved.
                                    494 ; Clobbers A, X, Y, m_s.
      0001AD                        495 udiv32:
      0001AD 3F 2C            [ 1]  496     clr     *m_r
      0001AF 3F 2D            [ 1]  497     clr     *m_r+1
      0001B1 3F 2E            [ 1]  498     clr     *m_r+2
      0001B3 3F 2F            [ 1]  499     clr     *m_r+3
      0001B5 35 20 00 0D      [ 1]  500     mov     m_s, #32
      0001B9                        501 00050$:
      0001B9 38 27            [ 1]  502     sll     *m_n+3                  ; N <<= 1, MSB -> C
      0001BB 39 26            [ 1]  503     rlc     *m_n+2
      0001BD 39 25            [ 1]  504     rlc     *m_n+1
      0001BF 39 24            [ 1]  505     rlc     *m_n
      0001C1 39 2F            [ 1]  506     rlc     *m_r+3                  ; C -> R
      0001C3 39 2E            [ 1]  507     rlc     *m_r+2
      0001C5 39 2D            [ 1]  508     rlc     *m_r+1
      0001C7 39 2C            [ 1]  509     rlc     *m_r
      0001C9 B6 2F            [ 1]  510     ld      a, *m_r+3               ; R - D (trial)
      0001CB B0 2B            [ 1]  511     sub     a, *m_d+3
      0001CD 97               [ 1]  512     ld      xl, a
      0001CE B6 2E            [ 1]  513     ld      a, *m_r+2
      0001D0 B2 2A            [ 1]  514     sbc     a, *m_d+2
      0001D2 95               [ 1]  515     ld      xh, a
      0001D3 B6 2D            [ 1]  516     ld      a, *m_r+1
      0001D5 B2 29            [ 1]  517     sbc     a, *m_d+1
      0001D7 90 97            [ 1]  518     ld      yl, a
      0001D9 B6 2C            [ 1]  519     ld      a, *m_r
      0001DB B2 28            [ 1]  520     sbc     a, *m_d
      0001DD 25 0A            [ 1]  521     jrc     00051$              ; R < D: restore (keep old R)
      0001DF B7 2C            [ 1]  522     ld      *m_r, a
      0001E1 90 9F            [ 1]  523     ld      a, yl
      0001E3 B7 2D            [ 1]  524     ld      *m_r+1, a
      0001E5 BF 2E            [ 2]  525     ldw     *m_r+2, x
      0001E7 3C 27            [ 1]  526     inc     *m_n+3                  ; quotient bit (bit0 is 0 after sll)
      0001E9                        527 00051$:
      0001E9 3A 0D            [ 1]  528     dec     *m_s
      0001EB 26 CC            [ 1]  529     jrne    00050$
      0001ED 81               [ 4]  530     ret
                                    531 
                                    532 ; negmn: m_n = -m_n (32-bit two's complement)
      0001EE                        533 negmn:
      0001EE 4F               [ 1]  534     clr     a
      0001EF B0 27            [ 1]  535     sub     a, *m_n+3
      0001F1 B7 27            [ 1]  536     ld      *m_n+3, a
      0001F3 4F               [ 1]  537     clr     a
      0001F4 B2 26            [ 1]  538     sbc     a, *m_n+2
      0001F6 B7 26            [ 1]  539     ld      *m_n+2, a
      0001F8 4F               [ 1]  540     clr     a
      0001F9 B2 25            [ 1]  541     sbc     a, *m_n+1
      0001FB B7 25            [ 1]  542     ld      *m_n+1, a
      0001FD 4F               [ 1]  543     clr     a
      0001FE B2 24            [ 1]  544     sbc     a, *m_n
      000200 B7 24            [ 1]  545     ld      *m_n, a
      000202 81               [ 4]  546     ret
                                    547 
                                    548 ; accum: Y = block (r_lo/r_hi), X = e (s16), m_y = y (u32 clamped):
                                    549 ;   se += sext(e); sy += y; n++
      000203                        550 accum:
      000203 9E               [ 1]  551     ld      a, xh
      000204 48               [ 1]  552     sll     a
      000205 4F               [ 1]  553     clr     a
      000206 A2 00            [ 1]  554     sbc     a, #0
      000208 B7 0D            [ 1]  555     ld      *m_s, a                 ; sign byte of e
      00020A 89               [ 2]  556     pushw   x                   ; (1,sp)=eH (2,sp)=eL
      00020B 90 E6 03         [ 1]  557     ld      a, (3, y)
      00020E 1B 02            [ 1]  558     add     a, (2, sp)
      000210 90 E7 03         [ 1]  559     ld      (3, y), a
      000213 90 E6 02         [ 1]  560     ld      a, (2, y)
      000216 19 01            [ 1]  561     adc     a, (1, sp)
      000218 90 E7 02         [ 1]  562     ld      (2, y), a
      00021B 90 E6 01         [ 1]  563     ld      a, (1, y)
      00021E B9 0D            [ 1]  564     adc     a, *m_s
      000220 90 E7 01         [ 1]  565     ld      (1, y), a
      000223 90 F6            [ 1]  566     ld      a, (y)
      000225 B9 0D            [ 1]  567     adc     a, *m_s
      000227 90 F7            [ 1]  568     ld      (y), a
      000229 85               [ 2]  569     popw    x
      00022A 90 E6 07         [ 1]  570     ld      a, (7, y)
      00022D BB 0C            [ 1]  571     add     a, *m_y+3
      00022F 90 E7 07         [ 1]  572     ld      (7, y), a
      000232 90 E6 06         [ 1]  573     ld      a, (6, y)
      000235 B9 0B            [ 1]  574     adc     a, *m_y+2
      000237 90 E7 06         [ 1]  575     ld      (6, y), a
      00023A 90 E6 05         [ 1]  576     ld      a, (5, y)
      00023D B9 0A            [ 1]  577     adc     a, *m_y+1
      00023F 90 E7 05         [ 1]  578     ld      (5, y), a
      000242 90 E6 04         [ 1]  579     ld      a, (4, y)
      000245 B9 09            [ 1]  580     adc     a, *m_y
      000247 90 E7 04         [ 1]  581     ld      (4, y), a
      00024A 90 E6 09         [ 1]  582     ld      a, (9, y)               ; n++ (16-bit, byte-wise: no LDW X,(o,Y))
      00024D AB 01            [ 1]  583     add     a, #1
      00024F 90 E7 09         [ 1]  584     ld      (9, y), a
      000252 90 E6 08         [ 1]  585     ld      a, (8, y)
      000255 A9 00            [ 1]  586     adc     a, #0
      000257 90 E7 08         [ 1]  587     ld      (8, y), a
      00025A 81               [ 4]  588     ret
                                    589 
                                    590 
                                    591 ; ---- relocated into the vector-table gap (vectors_prod.s): 0x8004..0x8063
                                    592     .area VGAP (ABS)
      008004                        593     .org 0x8004
                                    594 
                                    595     .globl sot                  ; exported ONLY as the guard_prod.py anchor
                                    596                                 ; for the VGAP window check (ABS areas
                                    597                                 ; print addr 0 in sdld maps)
      008004 00 04 09 0D 11 15 1B   598 sot: .db 0, 4, 9, 13, 17, 21, 27, 32       ; O_CY[8]
             20
      00800C 00 FF 00 02 00 00 00   599 swt: .db 0, 0xFF, 0, 2, 0, 0, 0, 1         ; W_CY[8] (s8)
             01
                                    600 
                                    601 ; mediv: X = block -> X = se/n as s16 (C truncation; |result| <= 256)
      008014                        602 mediv:
      008014 89               [ 2]  603     pushw   x                   ; block ptr at (1,sp)
      008015 FE               [ 2]  604     ldw     x, (x)
      008016 BF 24            [ 2]  605     ldw     *m_n, x
      008018 1E 01            [ 2]  606     ldw     x, (1, sp)
      00801A EE 02            [ 2]  607     ldw     x, (2, x)
      00801C BF 26            [ 2]  608     ldw     *m_n+2, x
      00801E 5F               [ 1]  609     clrw    x
      00801F BF 28            [ 2]  610     ldw     *m_d, x
      008021 1E 01            [ 2]  611     ldw     x, (1, sp)
      008023 EE 08            [ 2]  612     ldw     x, (8, x)
      008025 BF 2A            [ 2]  613     ldw     *m_d+2, x
      008027 85               [ 2]  614     popw    x
      008028 3F 5C            [ 1]  615     clr     *r_sgn
      00802A 3D 24            [ 1]  616     tnz     *m_n
      00802C 2A 07            [ 1]  617     jrpl    00055$
      00802E 35 01 00 5C      [ 1]  618     mov     r_sgn, #1
      008032 CD 01 EE         [ 4]  619     call    negmn
      008035                        620 00055$:
      008035 CD 01 AD         [ 4]  621     call    udiv32
      008038 BE 26            [ 2]  622     ldw     x, *m_n+2
      00803A 3D 5C            [ 1]  623     tnz     *r_sgn
      00803C 27 01            [ 1]  624     jreq    00056$
      00803E 50               [ 2]  625     negw    x
      00803F                        626 00056$:
      00803F 81               [ 4]  627     ret
                                    628 
                                    629 ; mydiv: X = block -> m_n = sy/n (u32)
      008040                        630 mydiv:
      008040 89               [ 2]  631     pushw   x
      008041 EE 04            [ 2]  632     ldw     x, (4, x)
      008043 BF 24            [ 2]  633     ldw     *m_n, x
      008045 1E 01            [ 2]  634     ldw     x, (1, sp)
      008047 EE 06            [ 2]  635     ldw     x, (6, x)
      008049 BF 26            [ 2]  636     ldw     *m_n+2, x
      00804B 5F               [ 1]  637     clrw    x
      00804C BF 28            [ 2]  638     ldw     *m_d, x
      00804E 1E 01            [ 2]  639     ldw     x, (1, sp)
      008050 EE 08            [ 2]  640     ldw     x, (8, x)
      008052 BF 2A            [ 2]  641     ldw     *m_d+2, x
      008054 85               [ 2]  642     popw    x
      008055 CC 01 AD         [ 2]  643     jp      udiv32
                                    644 
                                    645 ; hix: A = f (0/1) -> X = f*64 (c_hist row base within ov.hist).
                                    646 ; Lives in the vector gap: 7 bytes that the REL side no longer pays for.
      008058                        647 hix:
      008058 5F               [ 1]  648     clrw    x
      008059 4D               [ 1]  649     tnz     a
      00805A 27 03            [ 1]  650     jreq    00510$
      00805C AE 00 40         [ 2]  651     ldw     x, #64
      00805F                        652 00510$:
      00805F 81               [ 4]  653     ret
